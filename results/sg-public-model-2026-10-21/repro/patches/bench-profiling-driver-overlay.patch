@@ -0,0 +1,215 @@
+package main
+
+import (
+	"compress/gzip"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDiagnosticProfilesDisabled(t *testing.T) {
+	calls := 0
+	hooks := profileHooks{
+		startCPU:  func(*os.File) error { calls++; return nil },
+		stopCPU:   func() { calls++ },
+		writeHeap: func(*os.File) error { calls++; return nil },
+	}
+	path := filepath.Join(t.TempDir(), "missing", "metadata.json")
+	p, err := startDiagnosticProfilesWithHooks("", "", path, hooks)
+	if err != nil || p != nil || p.Close(nil) != nil || calls != 0 {
+		t.Fatalf("disabled hooks changed behavior: profiler=%v error=%v calls=%d", p, err, calls)
+	}
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("disabled profiling created a file", err)
+	}
+}
+
+func TestDiagnosticProfilesCleanup(t *testing.T) {
+	for _, failAt := range []string{"", "cpu-start", "heap-write", "reserved-heap", "reserved-metadata"} {
+		t.Run(failAt, func(t *testing.T) {
+			dir := t.TempDir()
+			cpu, heap, metadata := filepath.Join(dir, "cpu.pprof"), filepath.Join(dir, "heap.pprof"), filepath.Join(dir, "profiles.json")
+			var start, stop, write int
+			hooks := profileHooks{
+				startCPU: func(*os.File) error {
+					start++
+					if failAt == "cpu-start" {
+						return errors.New("start failed")
+					}
+					return nil
+				},
+				stopCPU: func() { stop++ },
+				writeHeap: func(f *os.File) error {
+					write++
+					if failAt == "heap-write" {
+						return errors.New("heap failed")
+					}
+					_, err := f.WriteString("heap")
+					return err
+				},
+			}
+			existing := ""
+			if failAt == "reserved-heap" {
+				existing = heap
+			}
+			if failAt == "reserved-metadata" {
+				existing = metadata
+			}
+			if existing != "" {
+				if err := os.WriteFile(existing, []byte("untouched"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			p, err := startDiagnosticProfilesWithHooks(cpu, heap, metadata, hooks)
+			if failAt == "cpu-start" || existing != "" {
+				if err == nil || p != nil {
+					t.Fatal("expected initialization error", p, err)
+				}
+				for _, path := range []string{cpu, heap, metadata} {
+					b, e := os.ReadFile(path)
+					if path == existing {
+						if e != nil || string(b) != "untouched" {
+							t.Fatal("existing artifact modified", path, e)
+						}
+					} else if !errors.Is(e, os.ErrNotExist) {
+						t.Fatal("failed initialization leaked reserved file", path, e)
+					}
+				}
+				if stop != 0 || write != 0 {
+					t.Fatal("profiler unexpectedly active", start, stop, write)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			closeErr := p.Close(context.DeadlineExceeded)
+			if (closeErr != nil) != (failAt == "heap-write") {
+				t.Fatal("unexpected close error", closeErr)
+			}
+			if p.Close(nil) != nil || start != 1 || stop != 1 || write != 1 {
+				t.Fatal("close was not idempotent", start, stop, write)
+			}
+			for _, f := range []*os.File{p.cpu, p.heap, p.metadata} {
+				if _, err := f.WriteString("closed"); !errors.Is(err, os.ErrClosed) {
+					t.Fatal("descriptor leaked", f.Name(), err)
+				}
+			}
+			var m map[string]any
+			readProcessOutput(t, metadata, &m)
+			if m["run_error"] != context.DeadlineExceeded.Error() || m["profile_complete"] != (failAt != "heap-write") || m["heap_extra_gc_forced"] != false {
+				t.Fatal("incorrect diagnostic metadata", m)
+			}
+		})
+	}
+}
+
+// Exercise the source-bound process boundary, not just the profile helper.
+// Profiling can affect clocks but must not change outcomes, witnesses or exits.
+func TestDiagnosticProfilesCLI(t *testing.T) {
+	root, err := filepath.Abs("../..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	env := append(os.Environ(), "GOTOOLCHAIN=local", "GOWORK=off", "GOPROXY=off", "GOSUMDB=off", "GOMAXPROCS=2")
+	binary := filepath.Join(t.TempDir(), "familybench")
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	build := exec.CommandContext(ctx, "sh", "scripts/build.sh", "familybench", binary)
+	build.Dir, build.Env = root, env
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("source-bound build: %v\n%s", err, output)
+	}
+	for _, algorithm := range []string{"raptor", "deliberately_unknown"} {
+		t.Run(algorithm, func(t *testing.T) {
+			var control []map[string]any
+			for _, mode := range []string{"omitted", "disabled", "enabled"} {
+				dir := t.TempDir()
+				out := filepath.Join(dir, "results")
+				cpu, heap := filepath.Join(dir, "cpu.pprof"), filepath.Join(dir, "heap.pprof")
+				args := []string{"-fixture", "testdata/tiny.manifest.json", "-algorithm", algorithm, "-out-dir", out, "-warmups", "0", "-repetitions", "1", "-batch-size", "1"}
+				if mode == "disabled" {
+					args = append(args, "-cpu-profile=", "-heap-profile=")
+				}
+				if mode == "enabled" {
+					args = append(args, "-cpu-profile", cpu, "-heap-profile", heap)
+				}
+				cmd := exec.CommandContext(ctx, binary, args...)
+				cmd.Dir, cmd.Env = root, env
+				output, runErr := cmd.CombinedOutput()
+				if algorithm == "raptor" && runErr != nil {
+					t.Fatalf("%s: %v\n%s", mode, runErr, output)
+				}
+				if algorithm != "raptor" {
+					var exited *exec.ExitError
+					if !errors.As(runErr, &exited) || exited.ExitCode() != 1 || !strings.Contains(string(output), "unknown algorithm") {
+						t.Fatalf("%s changed failure exit: %v\n%s", mode, runErr, output)
+					}
+				}
+				var summary map[string]any
+				readProcessOutput(t, filepath.Join(out, "summary.json"), &summary)
+				if summary["success"] != (algorithm == "raptor") {
+					t.Fatal("summary outcome changed", mode)
+				}
+				var outcomes []map[string]any
+				for _, name := range []string{"pass-00.json", "forced-deadline.json"} {
+					var artifact struct {
+						Records []map[string]any `json:"records"`
+					}
+					readProcessOutput(t, filepath.Join(out, name), &artifact)
+					for _, r := range artifact.Records {
+						v := map[string]any{}
+						for _, key := range []string{"query", "raw", "final", "display_options", "completed", "attempted", "valid_empty", "transit", "status", "error", "certificates"} {
+							v[key] = r[key]
+						}
+						outcomes = append(outcomes, v)
+					}
+				}
+				if mode == "omitted" {
+					control = outcomes
+				} else if !reflect.DeepEqual(control, outcomes) {
+					t.Fatalf("%s changed non-timing output", mode)
+				}
+				metadata := filepath.Join(out, "diagnostic-profiles.json")
+				if mode != "enabled" {
+					if _, err := os.Stat(metadata); !errors.Is(err, os.ErrNotExist) {
+						t.Fatal("disabled mode wrote metadata", err)
+					}
+					continue
+				}
+				for _, path := range []string{cpu, heap} {
+					f, err := os.Open(path)
+					if err != nil {
+						t.Fatal(err)
+					}
+					z, err := gzip.NewReader(f)
+					if err != nil {
+						_ = f.Close()
+						t.Fatal("invalid pprof gzip", path, err)
+					}
+					b, err := io.ReadAll(z)
+					_ = z.Close()
+					_ = f.Close()
+					if err != nil || len(b) == 0 {
+						t.Fatal("empty/broken pprof payload", path, err)
+					}
+				}
+				var m map[string]any
+				readProcessOutput(t, metadata, &m)
+				if m["profile_complete"] != true || m["diagnostic_only"] != true {
+					t.Fatal("profiles not complete", m)
+				}
+				if (m["run_error"] == "") != (algorithm == "raptor") {
+					t.Fatal("failure diagnostic not retained", m)
+				}
+			}
+		})
+	}
+}
