diff --git a/cmd/familybench/profiling.go b/cmd/familybench/profiling.go
new file mode 100644
index 0000000000000000000000000000000000000000..98251e5e8b79c1e43d1530ce76db72dccc953077
--- /dev/null
+++ b/cmd/familybench/profiling.go
@@ -0,0 +1,136 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"runtime/pprof"
+)
+
+// Diagnostic profiles cover the complete run after flags/output-directory
+// creation, including source verification, load, preparation, queries and
+// artifact encoding. They are not an instrumented replacement for final timing.
+// Heap sampling is unchanged and no extra GC is forced.
+type diagnosticProfiles struct {
+	cpu, heap, metadata *os.File
+	cpuStarted          bool
+	closed              bool
+	hooks               profileHooks
+}
+
+type profileHooks struct {
+	startCPU  func(*os.File) error
+	stopCPU   func()
+	writeHeap func(*os.File) error
+}
+
+func startDiagnosticProfiles(cpuPath, heapPath, metadataPath string) (*diagnosticProfiles, error) {
+	return startDiagnosticProfilesWithHooks(cpuPath, heapPath, metadataPath, profileHooks{
+		startCPU:  func(f *os.File) error { return pprof.StartCPUProfile(f) },
+		stopCPU:   pprof.StopCPUProfile,
+		writeHeap: func(f *os.File) error { return pprof.WriteHeapProfile(f) },
+	})
+}
+
+func startDiagnosticProfilesWithHooks(cpuPath, heapPath, metadataPath string, hooks profileHooks) (*diagnosticProfiles, error) {
+	if cpuPath == "" && heapPath == "" {
+		return nil, nil
+	}
+	p := &diagnosticProfiles{hooks: hooks}
+	// Reserve every path before starting the process-global CPU profiler. Never
+	// truncate an existing artifact. Failed initialization removes only our files.
+	open := func(path string, target **os.File) error {
+		if path == "" {
+			return nil
+		}
+		f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			return fmt.Errorf("diagnostic profile %q: %w", path, err)
+		}
+		*target = f
+		return nil
+	}
+	abort := func() {
+		for _, f := range []*os.File{p.cpu, p.heap, p.metadata} {
+			if f != nil {
+				_ = f.Close()
+				_ = os.Remove(f.Name())
+			}
+		}
+	}
+	if err := open(cpuPath, &p.cpu); err != nil {
+		abort()
+		return nil, err
+	}
+	if err := open(heapPath, &p.heap); err != nil {
+		abort()
+		return nil, err
+	}
+	if err := open(metadataPath, &p.metadata); err != nil {
+		abort()
+		return nil, err
+	}
+	if p.cpu != nil {
+		if err := p.hooks.startCPU(p.cpu); err != nil {
+			abort()
+			return nil, fmt.Errorf("start CPU profile: %w", err)
+		}
+		p.cpuStarted = true
+	}
+	return p, nil
+}
+
+// Close must be deferred immediately after successful initialization. It is
+// idempotent and runs for ordinary errors/deadlines as well as success. SIGKILL,
+// os.Exit and the existing abrupt RSS safety exit cannot run deferred cleanup.
+// A reserved but empty metadata file then identifies an unfinished diagnostic.
+func (p *diagnosticProfiles) Close(runErr error) error {
+	if p == nil || p.closed {
+		return nil
+	}
+	p.closed = true
+	var err error
+	cpuPath, heapPath := "", ""
+	if p.cpu != nil {
+		cpuPath = p.cpu.Name()
+		if p.cpuStarted {
+			p.hooks.stopCPU()
+			p.cpuStarted = false
+		}
+		err = errors.Join(err, p.cpu.Close())
+	}
+	if p.heap != nil {
+		heapPath = p.heap.Name()
+		err = errors.Join(err, p.hooks.writeHeap(p.heap), p.heap.Close())
+	}
+	if p.metadata != nil {
+		message, profileError := "", ""
+		if runErr != nil {
+			message = runErr.Error()
+		}
+		if err != nil {
+			profileError = err.Error()
+		}
+		value := map[string]any{
+			"schema":                "familybench_diagnostic_profiles_v1",
+			"diagnostic_only":       true,
+			"scope":                 "whole run after flags/output directory creation through return; includes source verification, input load, preparation, queries, validation/ranking and artifact encoding",
+			"cpu_profile":           cpuPath,
+			"heap_profile":          heapPath,
+			"heap_mem_profile_rate": runtime.MemProfileRate,
+			"heap_extra_gc_forced":  false,
+			"ordinary_return":       true,
+			"run_error":             message,
+			"profile_error":         profileError,
+			"profile_complete":      err == nil,
+			"timing_warning":        "diagnostic profiling overhead is present; do not use this run for final latency or speedup claims",
+		}
+		err = errors.Join(err, json.NewEncoder(p.metadata).Encode(value), p.metadata.Close())
+	}
+	if err != nil {
+		return fmt.Errorf("close diagnostic profiles: %w", err)
+	}
+	return nil
+}
