+// Retain Walker.Paths' cancellation boundary on cache hits, but use the already
+// known source ordinal and map each path target only once per query closure.
+func (w *denseWalks) paths(ctx context.Context, from int) (indexedPaths, error) {
+	if p := w.cache[from]; p.paths != nil {
+		if err := ctx.Err(); err != nil {
+			return indexedPaths{}, err
+		}
+		return p, nil
+	}
+	paths, err := w.walker.Paths(ctx, w.index.stopNames[from])
+	if err != nil {
+		return indexedPaths{}, err
+	}
+	p := indexedPaths{paths: paths, tos: make([]int, len(paths))}
+	for i, path := range paths {
+		p.tos[i] = w.index.stopIDs[path.To]
+	}
+	w.cache[from] = p
+	return p, nil
 }
 
