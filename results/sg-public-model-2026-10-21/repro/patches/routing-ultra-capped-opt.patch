+		got, e := x.Search(context.Background(), q, denseLimits())
+		want, we := f.Search(context.Background(), q, denseLimits())
+		checkDenseResult(t, d, q, got, e, want, we)
+	}
+	got, e := x.Search(context.Background(), base, Limits{})
+	want, we := f.Search(context.Background(), base, Limits{})
+	checkDenseResult(t, d, base, got, e, want, we)
+	var nilDense *CappedIndex
+	var nilFrozen *frozenCappedIndex
+	got, e = nilDense.Search(context.Background(), base, denseLimits())
+	want, we = nilFrozen.Search(context.Background(), base, denseLimits())
+	checkDenseResult(t, d, base, got, e, want, we)
+}
diff --git a/ultra/capped_frozen_baseline_test.go b/ultra/capped_frozen_baseline_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7dafe4c0dd50c95b15a5ac2eab55ed453ddc307a
--- /dev/null
+++ b/ultra/capped_frozen_baseline_test.go
@@ -0,0 +1,276 @@
+// Frozen verbatim algorithm from routing b102816; only receiver/type names change.
+package ultra
+
+import (
+	"container/heap"
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/paper"
+)
+
+// frozenCappedIndex owns immutable timetable and walking data. Queries may vary every
+// role cap (transfer <= prepared ceiling), buffer, source and destination. The
+// supported objective is arrival/boarding representatives, not walking Pareto.
+// Static stop-pair rules and pickup/dropoff are supported. All paper.Profile
+// aggregate-resource and trip/route-rule guards remain in force.
+type frozenCappedIndex struct {
+	x    *Index
+	prep CappedPreparation
+	rows map[string][]paper.Path
+	at   map[string][]occurrence
+}
+
+func (x *frozenCappedIndex) Preparation() CappedPreparation { return x.prep }
+func (x *frozenCappedIndex) Complete() bool                 { return x.prep.Complete }
+
+// frozenBuildCapped performs finite, budgeted shortest walking searches, independent
+// of timetable event count and query destination. No query can use an incomplete
+// index. MaxRuns bounds rows, MaxShortcuts bounds nonempty transfer pairs, and
+// MaxOutputLegs bounds retained raw edge witnesses. Other limits retain their
+// ordinary ULTRA work meanings. No Core-CH or timetable shortcut sparsity is
+// claimed in this mode.
+func frozenBuildCapped(ctx context.Context, d model.Dataset, cfg CappedConfig) (out *frozenCappedIndex, err error) {
+	out = &frozenCappedIndex{prep: CappedPreparation{Profile: "ultra_raptor_transfer_complete_capped_v1", Config: cfg}, rows: map[string][]paper.Path{}, at: map[string][]occurrence{}}
+	defer func() {
+		out.prep.Complete = err == nil
+		if err != nil {
+			out.prep.Error = err.Error()
+		}
+	}()
+	if !validLimits(cfg.Limits) || cfg.TransferWalkingLimit < 0 || cfg.TransferWalkingLimit > model.MaxServiceSecond {
+		return out, fmt.Errorf("ULTRA capped: invalid preparation configuration")
+	}
+	if err = ctx.Err(); err != nil {
+		return
+	}
+	p, e := paper.New(d)
+	if e != nil {
+		return out, e
+	}
+	x := &Index{p: p, transit: map[string]bool{}, rawOut: map[string][]model.Footpath{}, rawIn: map[string][]model.Footpath{}}
+	out.x = x
+	byTrip := map[string][]model.Connection{}
+	for _, c := range p.Data.Connections {
+		byTrip[c.TripID] = append(byTrip[c.TripID], c)
+		x.transit[c.From] = true
+		x.transit[c.To] = true
+	}
+	for _, edge := range p.Data.Footpaths {
+		if cfg.AccessibleOnly && (edge.Accessible != model.Yes || p.Stops[edge.From].Accessible != model.Yes || p.Stops[edge.To].Accessible != model.Yes) {
+			continue
+		}
+		x.rawOut[edge.From] = append(x.rawOut[edge.From], edge)
+		x.rawIn[edge.To] = append(x.rawIn[edge.To], edge)
+	}
+	for _, m := range []map[string][]model.Footpath{x.rawOut, x.rawIn} {
+		for id := range m {
+			sort.Slice(m[id], func(i, j int) bool { return m[id][i].ID < m[id][j].ID })
+		}
+	}
+	w := work{ctx, cfg.Limits, &out.prep.Stats}
+	if err = out.buildCappedRoutes(byTrip, &w); err != nil {
+		return
+	}
+	out.prep.Routes = len(x.routes)
+	sources := []string{}
+	for id := range x.transit {
+		if !cfg.AccessibleOnly || p.Stops[id].Accessible == model.Yes {
+			sources = append(sources, id)
+		}
+	}
+	sort.Strings(sources)
+	for _, source := range sources {
+		if err = w.check(); err != nil {
+			return
+		}
+		if out.prep.Stats.Runs == cfg.Limits.MaxRuns {
+			return out, fmt.Errorf("ULTRA capped incomplete: transfer-row budget exhausted")
+		}
+		out.prep.Stats.Runs++
+		var r rawSearch
+		r, err = out.walk(source, cfg.TransferWalkingLimit, false, "", &w)
+		if err != nil {
+			return
+		}
+		paths := []paper.Path{}
+		targets := []string{}
+		for target := range r.distance {
+			if x.transit[target] {
+				targets = append(targets, target)
+			}
+		}
+		sort.Strings(targets)
+		for _, target := range targets {
+			duration := r.distance[target]
+			if target != source {
+				if out.prep.TransferPairs == cfg.Limits.MaxShortcuts {
+					return out, fmt.Errorf("ULTRA capped incomplete: transfer-pair budget exhausted")
+				}
+				out.prep.TransferPairs++
+			}
+			path := paper.Path{To: target, Duration: duration}
+			// Charge before allocating potentially long retained raw witnesses.
+			path.Edges, err = out.path(r, target, &w)
+			if err != nil {
+				return
+			}
+			paths = append(paths, path)
+		}
+		out.rows[source] = paths
+		out.prep.TransferRows++
+	}
+	return
+}
+
+// Capped groups include boarding restrictions and trip accessibility. Earlier
+// FIFO trips dominate later trips only when these signatures match. Equal-time
+// and repeated-stop trips are safe: each position is separately indexed.
+func (x *frozenCappedIndex) buildCappedRoutes(byTrip map[string][]model.Connection, w *work) error {
+	patterns := map[string][]trip{}
+	ids := []string{}
+	for id := range byTrip {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		cs := byTrip[id]
+		sort.Slice(cs, func(i, j int) bool { return cs[i].Sequence < cs[j].Sequence })
+		type signature struct {
+			From, To        string
+			Pickup, Dropoff bool
+		}
+		ss := []signature{}
+		for _, c := range cs {
+			if e := w.connection(); e != nil {
+				return e
+			}
+			ss = append(ss, signature{c.From, c.To, c.Pickup, c.Dropoff})
+		}
+		key, _ := json.Marshal(struct {
+			Segments   []signature
+			Accessible model.Access
+		}{ss, x.x.p.Trips[id].Accessible})
+		patterns[string(key)] = append(patterns[string(key)], trip{id, cs})
+	}
+	keys := []string{}
+	for key := range patterns {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		ts := patterns[key]
+		sort.Slice(ts, func(i, j int) bool {
+			if ts[i].cs[0].Departure == ts[j].cs[0].Departure {
+				return ts[i].id < ts[j].id
+			}
+			return ts[i].cs[0].Departure < ts[j].cs[0].Departure
+		})
+		groups := []route{}
+		for _, t := range ts {
+			placed := false
+			for g := range groups {
+				prior := groups[g].trips[len(groups[g].trips)-1]
+				ok := true
+				for i, c := range t.cs {
+					if e := w.connection(); e != nil {
+						return e
+					}
+					w.s.GroupingComparisons++
+					if c.Departure < prior.cs[i].Departure || c.Arrival < prior.cs[i].Arrival {
+						ok = false
+						break
+					}
+				}
+				if ok {
+					groups[g].trips = append(groups[g].trips, t)
+					placed = true
+					break
+				}
+			}
+			if !placed {
+				groups = append(groups, route{[]trip{t}})
+			}
+		}
+		x.x.routes = append(x.x.routes, groups...)
+	}
+	for ri, r := range x.x.routes {
+		for pos, c := range r.trips[0].cs {
+			if c.Pickup {
+				x.at[c.From] = append(x.at[c.From], occurrence{ri, pos})
+			}
+		}
+	}
+	return w.check()
+}
+
+// walk uses the same raw directed Dijkstra/tie policy as legacy ULTRA, with an
+// absorbing destination and the accessibility-filtered prepared graph.
+func (x *frozenCappedIndex) walk(source string, maximum int64, reverse bool, absorbing string, w *work) (rawSearch, error) {
+	r := rawSearch{map[string]int64{source: 0}, map[string]model.Footpath{}, source, reverse}
+	q := &rawQueue{{source, 0}}
+	for q.Len() > 0 {
+		u := heap.Pop(q).(rawEntry)
+		if r.distance[u.v] != u.t {
+			continue
+		}
+		if e := w.settle(); e != nil {
+			return r, e
+		}
+		if !reverse && u.v == absorbing {
+			continue
+		}
+		edges := x.x.rawOut[u.v]
+		if reverse {
+			edges = x.x.rawIn[u.v]
+		}
+		for _, edge := range edges {
+			if e := w.edge(); e != nil {
+				return r, e
+			}
+			to := edge.To
+			if reverse {
+				to = edge.From
+			}
+			nt := u.t + edge.Duration
+			if nt > maximum {
+				continue
+			}
+			if old, ok := r.distance[to]; ok && old <= nt {
+				continue
+			}
+			r.distance[to] = nt
+			r.parent[to] = edge
+			heap.Push(q, rawEntry{to, nt})
+		}
+	}
+	return r, nil
+}
+
+func (x *frozenCappedIndex) path(r rawSearch, target string, w *work) ([]model.Footpath, error) {
+	edges := []model.Footpath{}
+	for at := target; at != r.source; {
+		if e := w.leg(); e != nil {
+			return nil, e
+		}
+		edge, ok := r.parent[at]
+		if !ok {
+			return nil, fmt.Errorf("ULTRA capped: missing raw path parent")
+		}
+		edges = append(edges, edge)
+		if r.reverse {
+			at = edge.To
+		} else {
+			at = edge.From
+		}
+	}
+	if !r.reverse {
+		for i, j := 0, len(edges)-1; i < j; i, j = i+1, j-1 {
+			edges[i], edges[j] = edges[j], edges[i]
+		}
+	}
+	return edges, nil
+}
diff --git a/ultra/capped_frozen_search_test.go b/ultra/capped_frozen_search_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3bcc5ea5e3bad8660d50697a20700f0c808c56bb
--- /dev/null
+++ b/ultra/capped_frozen_search_test.go
@@ -0,0 +1,280 @@
+// Frozen verbatim search from routing b102816; only receiver name changes.
+package ultra
+
+import (
+	"context"
+	"fmt"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/paper"
+	"sort"
+)
+
+// Search implements exact-round ULTRA-RAPTOR using one-hop completed transfers.
+// Apply pair-specific readiness before merging labels; never chain shortcuts.
+func (x *frozenCappedIndex) Search(ctx context.Context, q model.Query, limits Limits) (out CappedResult, err error) {
+	out.Journeys = []model.Journey{}
+	defer func() {
+		out.Complete = err == nil
+		if err != nil {
+			out.Error = err.Error()
+		}
+	}()
+	if x == nil || !x.Complete() {
+		return out, fmt.Errorf("ULTRA capped: incomplete index")
+	}
+	if !validLimits(limits) {
+		return out, fmt.Errorf("ULTRA capped: explicit positive query limits required")
+	}
+	if err = x.x.p.CheckContext(ctx, q); err != nil {
+		return
+	}
+	if q.AccessibleOnly != x.prep.Config.AccessibleOnly {
+		return out, fmt.Errorf("ULTRA capped capability: accessibility differs from prepared graph")
+	}
+	if q.Walking.Transfer > x.prep.Config.TransferWalkingLimit {
+		return out, fmt.Errorf("ULTRA capped capability: transfer cap exceeds prepared ceiling")
+	}
+	if err = ctx.Err(); err != nil {
+		return
+	}
+	p := x.x.p
+	if !p.Accessible(q, q.Origin) || !p.Accessible(q, q.Destination) {
+		return
+	}
+	if q.Origin == q.Destination {
+		out.Journeys = append(out.Journeys, paper.Journey(nil))
+		return
+	}
+	w := work{ctx, limits, &out.Stats.Stats}
+	forward, e := x.walk(q.Origin, min(max(q.Walking.Access, q.Walking.Direct), q.LatestArrival-q.Departure), false, q.Destination, &w)
+	out.Stats.WalkSearches++
+	if e != nil {
+		return out, e
+	}
+	var backward rawSearch
+	if q.MaxBoardings > 0 {
+		backward, err = x.walk(q.Destination, min(q.Walking.Egress, q.LatestArrival-q.Departure), true, "", &w)
+		out.Stats.WalkSearches++
+		if err != nil {
+			return
+		}
+	}
+	emit := func(parent *paper.Node) error {
+		for n := parent; n != nil; n = n.Previous {
+			if e := w.leg(); e != nil {
+				return e
+			}
+		}
+		out.Journeys = append(out.Journeys, paper.Journey(parent))
+		return nil
+	}
+	previous := map[string]paper.Label{}
+	endpoints := []string{}
+	for stop := range forward.distance {
+		endpoints = append(endpoints, stop)
+	}
+	sort.Strings(endpoints)
+	bestArrival := paper.Infinity
+	for _, stop := range endpoints {
+		at := q.Departure + forward.distance[stop]
+		if at > q.LatestArrival {
+			continue
+		}
+		if stop == q.Destination {
+			if forward.distance[stop] <= q.Walking.Direct {
+				edges, e := x.path(forward, stop, &w)
+				if e != nil {
+					return out, e
+				}
+				bestArrival = at
+				if err = emit((paper.Path{Edges: edges}).Append(nil, q.Departure)); err != nil {
+					return
+				}
+			}
+		} else if q.MaxBoardings > 0 && x.x.transit[stop] && forward.distance[stop] <= q.Walking.Access {
+			edges, e := x.path(forward, stop, &w)
+			if e != nil {
+				return out, e
+			}
+			previous[stop] = paper.Label{Time: at, Parent: (paper.Path{Edges: edges}).Append(nil, q.Departure)}
+		}
+	}
+	rows := map[string][]paper.Path{}
+	getRow := func(from string) ([]paper.Path, error) {
+		if r, ok := rows[from]; ok {
+			return r, nil
+		}
+		out.Stats.RowUses++
+		r := []paper.Path{}
+		var detour *rawSearch
+		for _, path := range x.rows[from] {
+			if e := w.check(); e != nil {
+				return nil, e
+			}
+			if path.To == q.Destination || path.Duration > q.Walking.Transfer {
+				continue
+			}
+			crosses := false
+			for _, edge := range path.Edges {
+				if e := w.edge(); e != nil {
+					return nil, e
+				}
+				if edge.To == q.Destination {
+					crosses = true
+					break
+				}
+			}
+			if crosses {
+				if detour == nil {
+					d, e := x.walk(from, q.Walking.Transfer, false, q.Destination, &w)
+					out.Stats.WalkSearches++
+					out.Stats.DestinationRepairs++
+					if e != nil {
+						return nil, e
+					}
+					detour = &d
+				}
+				duration, ok := detour.distance[path.To]
+				if !ok {
+					continue
+				}
+				edges, e := x.path(*detour, path.To, &w)
+				if e != nil {
+					return nil, e
+				}
+				path = paper.Path{To: path.To, Duration: duration, Edges: edges}
+			}
+			r = append(r, path)
+		}
+		rows[from] = r
+		return r, nil
+	}
+	egress := map[string][]model.Footpath{}
+	for boards := 1; boards <= q.MaxBoardings && len(previous) > 0; boards++ {
+		if err = w.check(); err != nil {
+			return
+		}
+		out.Stats.Rounds++
+		selected := map[int]int{}
+		for stop := range previous {
+			for _, o := range x.at[stop] {
+				if err = w.connection(); err != nil {
+					return
+				}
+				out.Stats.RouteOccurrenceChecks++
+				if old, ok := selected[o.route]; !ok || o.position < old {
+					selected[o.route] = o.position
+				}
+			}
+		}
+		routeIDs := []int{}
+		for id := range selected {
+			routeIDs = append(routeIDs, id)
+		}
+		sort.Ints(routeIDs)
+		next := map[string]paper.Label{}
+		best := paper.Label{Time: bestArrival}
+		for _, ri := range routeIDs {
+			if err = w.check(); err != nil {
+				return
+			}
+			out.Stats.RouteScans++
+			r := x.x.routes[ri]
+			if !p.TripAllowed(q, r.trips[0].id) {
+				continue
+			}
+			current := -1
+			var parent *paper.Node
+			for pos := selected[ri]; pos < len(r.trips[0].cs); pos++ {
+				if err = w.connection(); err != nil {
+					return
+				}
+				proto := r.trips[0].cs[pos]
+				if l, ok := previous[proto.From]; ok && proto.Pickup && p.Accessible(q, proto.From) {
+					lo, hi := 0, len(r.trips)
+					if current >= 0 {
+						hi = current
+					}
+					for lo < hi {
+						if err = w.connection(); err != nil {
+							return
+						}
+						out.Stats.TripProbes++
+						mid := lo + (hi-lo)/2
+						if r.trips[mid].cs[pos].Departure < l.Time {
+							lo = mid + 1
+						} else {
+							hi = mid
+						}
+					}
+					if lo < len(r.trips) && (current < 0 || lo < current) {
+						current = lo
+						parent = l.Parent
+					}
+				}
+				if current < 0 {
+					continue
+				}
+				c := r.trips[current].cs[pos]
+				if c.Arrival > q.LatestArrival {
+					current = -1
+					continue
+				}
+				parent = paper.Ride(parent, c)
+				if !c.Dropoff || !p.Accessible(q, c.To) {
+					continue
+				}
+				if c.To == q.Destination {
+					if c.Arrival < best.Time {
+						best = paper.Label{Time: c.Arrival, Parent: parent}
+					}
+					current = -1
+					continue
+				}
+				if duration, ok := backward.distance[c.To]; ok && c.Arrival+duration < best.Time && c.Arrival+duration <= q.LatestArrival {
+					edges, exists := egress[c.To]
+					if !exists {
+						edges, err = x.path(backward, c.To, &w)
+						if err != nil {
+							return
+						}
+						egress[c.To] = edges
+					}
+					best = paper.Label{Time: c.Arrival + duration, Parent: (paper.Path{Edges: edges}).Append(parent, c.Arrival)}
+				}
+				if boards == q.MaxBoardings || c.Arrival >= best.Time {
+					continue
+				}
+				paths, e := getRow(c.To)
+				if e != nil {
+					return out, e
+				}
+				for _, path := range paths {
+					if err = w.edge(); err != nil {
+						return
+					}
+					out.Stats.TransferPairVisits++
+					ready, allowed, e := p.ReadyTime(q, c.To, path.To, c.Arrival, path.Duration)
+					if e != nil {
+						return out, e
+					}
+					if !allowed || ready > q.LatestArrival || ready >= best.Time {
+						continue
+					}
+					old, ok := next[path.To]
+					if !ok || ready < old.Time {
+						next[path.To] = paper.Label{Time: ready, Parent: path.Append(parent, c.Arrival)}
+					}
+				}
+			}
+		}
+		if best.Time < bestArrival {
+			if err = emit(best.Parent); err != nil {
+				return
+			}
+			bestArrival = best.Time
+		}
+		previous = next
+	}
+	return
+}
diff --git a/ultra/capped_frozen_sparse_test.go b/ultra/capped_frozen_sparse_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b606188c05af4a4857e850af5afa04a1bbb47bb
--- /dev/null
+++ b/ultra/capped_frozen_sparse_test.go
@@ -0,0 +1,224 @@
+// Frozen verbatim sparse algorithm from routing b102816; only names change.
+package ultra
+
+import (
+	"context"
+	"fmt"
+	"sort"
+
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/paper"
+)
+
+type frozenSparseIndex struct {
+	index *frozenCappedIndex
+	prep  SparsePreparation
+}
+
+func (x *frozenSparseIndex) Complete() bool { return x != nil && x.prep.Complete }
+func (x *frozenSparseIndex) Preparation() SparsePreparation {
+	s := x.prep
+	s.Certificates = append([]PrunedTransfer{}, s.Certificates...)
+	for i := range s.Certificates {
+		s.Certificates[i].Proofs = append([]StayProof{}, s.Certificates[i].Proofs...)
+	}
+	return s
+}
+
+// frozenBuildSparse first prepares the complete control, then removes only forbidden,
+// structurally/time-infeasible pairs and pairs with a stay-on-incoming-trip
+// witness for EVERY possible alighting event. Empty self transfers are NEVER
+// removed: all stay witnesses use only these, so pruning has no dependency cycle.
+// Preparation still pays the complete-control cost. Certificates add audit memory;
+// no peak-memory or paper-level shortcut-sparsity guarantee is made.
+func frozenBuildSparse(ctx context.Context, d model.Dataset, cfg SparseConfig) (out *frozenSparseIndex, err error) {
+	out = &frozenSparseIndex{prep: SparsePreparation{Profile: "ultra_cap_safe_stay_witness_subset_v1", Config: cfg, Certificates: []PrunedTransfer{}}}
+	defer func() {
+		out.prep.Complete = err == nil
+		if err != nil {
+			out.prep.Error = err.Error()
+		}
+	}()
+	if cfg.MaxProofChecks <= 0 || cfg.TransferBuffer < 0 || cfg.TransferBuffer > model.MaxServiceSecond {
+		return out, fmt.Errorf("ULTRA sparse: invalid proof/buffer configuration")
+	}
+	out.index, err = frozenBuildCapped(ctx, d, cfg.Capped)
+	out.prep.Control = out.index.Preparation()
+	if err != nil {
+		return
+	}
+	check := func() error {
+		if e := ctx.Err(); e != nil {
+			return e
+		}
+		if out.prep.ProofChecks == cfg.MaxProofChecks {
+			return fmt.Errorf("ULTRA sparse incomplete: proof budget exhausted")
+		}
+		out.prep.ProofChecks++
+		return nil
+	}
+	p := out.index.x.p
+	incoming := map[string][]model.Connection{}
+	future := map[string]map[string][]model.Connection{}
+	lastDeparture := map[string]int64{}
+	for _, c := range p.Data.Connections {
+		if err = check(); err != nil {
+			return
+		}
+		if cfg.Capped.AccessibleOnly && p.Trips[c.TripID].Accessible != model.Yes {
+			continue
+		}
+		if c.Pickup && (!cfg.Capped.AccessibleOnly || p.Stops[c.From].Accessible == model.Yes) {
+			old, ok := lastDeparture[c.From]
+			if !ok || c.Departure > old {
+				lastDeparture[c.From] = c.Departure
+			}
+		}
+		if !c.Dropoff || cfg.Capped.AccessibleOnly && p.Stops[c.To].Accessible != model.Yes {
+			continue
+		}
+		incoming[c.To] = append(incoming[c.To], c)
+		if future[c.TripID] == nil {
+			future[c.TripID] = map[string][]model.Connection{}
+		}
+		future[c.TripID][c.To] = append(future[c.TripID][c.To], c)
+	}
+	// Sorting is input-sized indexing, outside certificate checks. Check context
+	// between lists; comparison queries below are individually budgeted.
+	for _, byStop := range future {
+		for stop, cs := range byStop {
+			if err = ctx.Err(); err != nil {
+				return
+			}
+			sort.Slice(cs, func(i, j int) bool { return cs[i].Sequence < cs[j].Sequence })
+			byStop[stop] = cs
+		}
+	}
+	for stop, cs := range incoming {
+		if err = ctx.Err(); err != nil {
+			return
+		}
+		sort.Slice(cs, func(i, j int) bool { return cs[i].ID < cs[j].ID })
+		incoming[stop] = cs
+	}
+	sources := []string{}
+	for from := range out.index.rows {
+		sources = append(sources, from)
+	}
+	sort.Strings(sources)
+	for _, from := range sources {
+		kept := []paper.Path{}
+		for _, path := range out.index.rows[from] {
+			if err = check(); err != nil {
+				return
+			}
+			if path.To == from {
+				kept = append(kept, path)
+				continue
+			}
+			cert := PrunedTransfer{From: from, To: path.To, Duration: path.Duration}
+			canPrune := false
+			arrivals := incoming[from]
+			last, hasDeparture := lastDeparture[path.To]
+			switch {
+			case len(arrivals) == 0:
+				cert.Reason = "no_alighting"
+				canPrune = true
+			case !hasDeparture:
+				cert.Reason = "no_boarding"
+				canPrune = true
+			default:
+				// Common profile rejects trip/route selectors, so this decision is static
+				// for the stop pair. Fixing Buffer keeps its default-minimum semantics.
+				decision, e := p.Rules.Resolve(model.Connection{To: from}, model.Connection{From: path.To}, cfg.TransferBuffer)
+				if e != nil {
+					return out, e
+				}
+				cert.Minimum = decision.Minimum
+				cert.LastDeparture = last
+				if !decision.Allowed {
+					cert.Reason = "prohibited"
+					canPrune = true
+					break
+				}
+				earliest := paper.Infinity
+				for _, c := range arrivals {
+					if err = check(); err != nil {
+						return
+					}
+					earliest = min(earliest, c.Arrival)
+				}
+				cert.EarliestArrival = earliest
+				if earliest+max(path.Duration, decision.Minimum) > last {
+					cert.Reason = "schedule"
+					canPrune = true
+					break
+				}
+				self, e := p.Rules.Resolve(model.Connection{To: path.To}, model.Connection{From: path.To}, cfg.TransferBuffer)
+				if e != nil {
+					return out, e
+				}
+				if !self.Allowed {
+					break
+				}
+				cert.SelfMinimum = self.Minimum
+				cert.Reason = "stay_on_trip"
+				canPrune = true
+				for _, c := range arrivals {
+					if err = check(); err != nil {
+						return
+					}
+					ready := c.Arrival + max(path.Duration, decision.Minimum)
+					proof := StayProof{Incoming: c.ID, Ready: ready}
+					if ready > last {
+						proof.TooLate = true
+						cert.Proofs = append(cert.Proofs, proof)
+						continue
+					}
+					cs := future[c.TripID][path.To]
+					lo, hi := 0, len(cs)
+					for lo < hi {
+						if err = check(); err != nil {
+							return
+						}
+						mid := lo + (hi-lo)/2
+						if cs[mid].Sequence <= c.Sequence {
+							lo = mid + 1
+						} else {
+							hi = mid
+						}
+					}
+					if lo == len(cs) || cs[lo].Arrival+self.Minimum > ready {
+						canPrune = false
+						break
+					}
+					proof.Witness = cs[lo].ID
+					proof.WitnessReady = cs[lo].Arrival + self.Minimum
+					cert.Proofs = append(cert.Proofs, proof)
+				}
+			}
+			if canPrune {
+				out.prep.Certificates = append(out.prep.Certificates, cert)
+				out.prep.PrunedPairs++
+			} else {
+				kept = append(kept, path)
+				out.prep.RetainedPairs++
+			}
+		}
+		out.index.rows[from] = kept
+	}
+	return
+}
+
+func (x *frozenSparseIndex) Search(ctx context.Context, q model.Query, l Limits) (CappedResult, error) {
+	fail := func(e error) (CappedResult, error) {
+		return CappedResult{Journeys: []model.Journey{}, Error: e.Error()}, e
+	}
+	if !x.Complete() {
+		return fail(fmt.Errorf("ULTRA sparse: incomplete index"))
+	}
+	if q.TransferBuffer != x.prep.Config.TransferBuffer {
+		return fail(fmt.Errorf("ULTRA sparse capability: transfer buffer differs from proof"))
+	}
+	return x.index.Search(ctx, q, l)
+}
