+	stopAccessible []bool
+	tripAccessible []bool
+}
+
+// Ordinals are immutable and refer to the profile's owned dataset, never the
+// caller's slices. Keep them aligned with the unchanged departure/ID scan order.
+type connectionIDs struct{ from, to, trip int }
+
+// A zero time means absent; reached labels store time+1. Validated service times
+// are nonnegative and bounded, including the zero-time, nil-parent access label.
+type readyLabel struct {
+	time   int64
+	parent *paper.Node
+}
+type tripState struct {
+	parent   *paper.Node
+	sequence int
+}
+
+type indexedPaths struct {
+	paths []paper.Path
+	tos   []int
+}
+type denseWalks struct {
+	walker *paper.Walker
+	index  *Index
+	cache  []indexedPaths
+}
+
+// Retain Walker.Paths' cancellation boundary on cache hits, but use the already
+// known source ordinal and map each path target only once per query closure.
+func (w *denseWalks) paths(ctx context.Context, from int) (indexedPaths, error) {
+	if p := w.cache[from]; p.paths != nil {
+		if err := ctx.Err(); err != nil {
+			return indexedPaths{}, err
+		}
+		return p, nil
+	}
+	paths, err := w.walker.Paths(ctx, w.index.stopNames[from])
+	if err != nil {
+		return indexedPaths{}, err
+	}
+	p := indexedPaths{paths: paths, tos: make([]int, len(paths))}
+	for i, path := range paths {
+		p.tos[i] = w.index.stopIDs[path.To]
+	}
+	w.cache[from] = p
+	return p, nil
 }
 
