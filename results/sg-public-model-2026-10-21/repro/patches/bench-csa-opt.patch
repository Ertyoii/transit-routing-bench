+package csa_test
+
+import (
+	"context"
+	"fmt"
+	"math/rand/v2"
+	"reflect"
+	"slices"
+	"testing"
+
+	"github.com/ertyoii/transit-routing-bench/oracle"
+	"github.com/ertyoii/transit-routing-go/csa"
+	"github.com/ertyoii/transit-routing-go/model"
+)
+
+func checkSuffixCaps(t testing.TB, d model.Dataset, qs []model.Query) {
+	t.Helper()
+	idx, err := csa.New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := csa.Config{MaxLabels: 300000, MaxJourneys: 100000, ExactTopK: 3}
+	for _, q := range qs {
+		r, err := idx.StratifiedSingle(context.Background(), q, cfg)
+		if err != nil || !r.CapComplete {
+			t.Fatalf("cap certificate: %+v %v", r, err)
+		}
+		for b, child := range r.CapResults {
+			cq := q
+			cq.MaxBoardings = b
+			o, err := oracle.Enumerate(context.Background(), d, cq, oracle.Limits{MaxStates: 300000, MaxJourneys: 100000})
+			if err != nil || !o.Complete {
+				t.Fatalf("inconclusive oracle: %v", err)
+			}
+			want := canonical(t, d, cq, o.Journeys)
+			want = want[:min(cfg.ExactTopK, len(want))]
+			if !child.Result.TopKComplete || !reflect.DeepEqual(canonical(t, d, cq, child.Result.Journeys), want) {
+				t.Fatalf("cap %d lost candidate identities", b)
+			}
+		}
+	}
+	for _, reverse := range []bool{false, true} {
+		ordered := slices.Clone(qs)
+		if reverse {
+			slices.Reverse(ordered)
+		}
+		batch, err := idx.StratifiedShared(context.Background(), ordered, cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, q := range ordered {
+			single, err := idx.StratifiedSingle(context.Background(), q, cfg)
+			if err != nil || !batch.Results[i].CapComplete || !reflect.DeepEqual(batch.Results[i].Journeys, single.Journeys) || batch.Results[i].Stats != single.Stats {
+				t.Fatalf("shared cap lane ordering changed results: %v", err)
+			}
+		}
+	}
+}
+
+func TestSuffixBoundsWithWalkingPhasesTransferRulesAndHorizon(t *testing.T) {
+	d, q := walkFixture()
+	qs := []model.Query{q}
+	for i, phase := range []string{"access", "egress", "transfer", "horizon", "total", "boards", "legs"} {
+		cq := q
+		cq.ID = phase
+		w := *q.Walking
+		cq.Walking = &w
+		switch i {
+		case 0:
+			w.Access = 599
+		case 1:
+			w.Egress = 599
+		case 2:
+			w.Transfer = 600
+		case 3:
+			cq.LatestArrival = 2199
+		case 4:
+			cq.MaxWalkSeconds = 1800
+		case 5:
+			cq.MaxBoardings = 1
+		case 6:
+			cq.MaxLegs = 4
+		}
+		qs = append(qs, cq)
+	}
+	for _, rules := range [][]model.TransferRule{nil,
+		{{ID: "forbid", FromStop: "C", ToStop: "D", Type: 3}},
+		{{ID: "minimum", FromStop: "C", ToStop: "D", Type: 2, MinSeconds: 701}},
+		{{ID: "forbid", FromStop: "C", ToStop: "D", Type: 3}, {ID: "exception", FromStop: "C", ToStop: "D", FromTrip: "one", ToTrip: "two", Type: 2, MinSeconds: 700}},
+	} {
+		d.Transfers = rules
+		topKDifferential(t, d, qs)
+		checkSuffixCaps(t, d, qs)
+	}
+}
+
+func TestSuffixBoundsStayAboardNoPickupDropoffAndZeroEvents(t *testing.T) {
+	d := model.Dataset{SchemaVersion: model.SchemaVersion, ID: "suffix-oracle", TimeZone: "Asia/Singapore", ServiceDate: "2026-10-20"}
+	for _, s := range []string{"A", "B", "C", "D", "X"} {
+		d.Stops = append(d.Stops, model.Stop{ID: s, Accessible: model.Yes})
+	}
+	d.Stops[4].Accessible = model.Unknown // May stay aboard, may not alight.
+	d.Trips = []model.Trip{{ID: "through", Accessible: model.Yes}, {ID: "parallel", Accessible: model.Yes}, {ID: "bad-pickup", Accessible: model.Yes}}
+	d.Connections = []model.Connection{
+		{ID: "z0", TripID: "through", From: "A", To: "X", Departure: 5, Arrival: 5, Pickup: true},
+		{ID: "a1", TripID: "through", Sequence: 1, From: "X", To: "B", Departure: 5, Arrival: 5},
+		{ID: "m2", TripID: "through", Sequence: 2, From: "B", To: "C", Departure: 5, Arrival: 8, Dropoff: true},
+		{ID: "parallel", TripID: "parallel", From: "A", To: "C", Departure: 5, Arrival: 8, Pickup: true, Dropoff: true},
+		{ID: "bad-pickup", TripID: "bad-pickup", From: "B", To: "D", Departure: 8, Arrival: 9, Dropoff: true},
+	}
+	d.Footpaths = []model.Footpath{{ID: "egress", From: "C", To: "D", Duration: 2, Accessible: model.Yes}, {ID: "reverse-only", From: "D", To: "A", Duration: 1, Accessible: model.Yes}, {ID: "cycle1", From: "B", To: "X", Duration: 1, Accessible: model.Yes}, {ID: "cycle2", From: "X", To: "B", Duration: 1, Accessible: model.Yes}}
+	q := model.Query{ID: "base", Origin: "A", Destination: "D", LatestArrival: 10, MaxWalkSeconds: 6, MaxBoardings: 3, MaxLegs: 6, AccessibleOnly: true}
+	qs := []model.Query{q}
+	for i := 0; i < 3; i++ {
+		cq := q
+		cq.ID = fmt.Sprint(i)
+		switch i {
+		case 0:
+			cq.Origin = "B"
+		case 1:
+			cq.LatestArrival = 9
+		case 2:
+			cq.AccessibleOnly = false
+		}
+		qs = append(qs, cq)
+	}
+	topKDifferential(t, d, qs)
+	checkSuffixCaps(t, d, qs)
+	slices.Reverse(d.Connections)
+	slices.Reverse(d.Footpaths)
+	slices.Reverse(qs)
+	topKDifferential(t, d, qs)
+	checkSuffixCaps(t, d, qs)
+}
+
+func TestSuffixBoundDeterministicTinyOracleSeeds(t *testing.T) {
+	for seed := uint64(0); seed < 128; seed++ {
+		rng := rand.New(rand.NewPCG(seed, seed+19))
+		d := model.Dataset{SchemaVersion: model.SchemaVersion, ID: "suffix-random", TimeZone: "Asia/Singapore", ServiceDate: "2026-10-20"}
+		stops := []string{"A", "B", "C"}
+		for _, s := range stops {
+			d.Stops = append(d.Stops, model.Stop{ID: s, Accessible: model.Yes})
+		}
+		for i := 0; i < 6; i++ {
+			id := fmt.Sprintf("r%d", i)
+			dep := int64(rng.IntN(8))
+			d.Trips = append(d.Trips, model.Trip{ID: id, Accessible: model.Yes})
+			d.Connections = append(d.Connections, model.Connection{ID: id, TripID: id, From: stops[rng.IntN(3)], To: stops[rng.IntN(3)], Departure: dep, Arrival: dep + int64(rng.IntN(3)), Pickup: rng.IntN(4) != 0, Dropoff: rng.IntN(4) != 0})
+		}
+		for i := 0; i < 2; i++ {
+			d.Footpaths = append(d.Footpaths, model.Footpath{ID: fmt.Sprintf("w%d", i), From: stops[rng.IntN(3)], To: stops[rng.IntN(3)], Duration: 1, Accessible: model.Yes})
+		}
+		q := model.Query{ID: fmt.Sprint(seed), Origin: "A", Destination: "C", LatestArrival: 12, MaxBoardings: 3, MaxLegs: 5, MaxWalkSeconds: 3, TransferBuffer: int64(rng.IntN(3))}
+		topKDifferential(t, d, []model.Query{q})
+		checkSuffixCaps(t, d, []model.Query{q})
+	}
+}
