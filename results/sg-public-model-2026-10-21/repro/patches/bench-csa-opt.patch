+// prepareSuffixBound computes a destination-directed timetable feasibility
+// relaxation for every remaining-boarding count. latest[b][s] is the latest
+// ready-to-board time at s from which the destination can be reached by the
+// horizon with at most b boardings. Walking is directed. Pickup, dropoff and
+// consecutive same-trip continuation are retained, including zero-time events.
+// Accessibility, transfer rules/buffers, walking resources and leg limits are
+// relaxed, never strengthened. Thus a missing suffix is a proof of infeasibility,
+// not a dominance claim between different journey identities.
+//
+// The optional layered certificate is limited to modest boarding counts to avoid
+// replacing bounded enumeration with unbounded preprocessing/memory on unusually
+// large valid queries. Other queries retain the existing last-boarding bound.
+func (l *lane) prepareSuffixBound() {
+	if l.err != nil {
+		return
+	}
+	const maximumBoundLayers = 16
+	if l.query.MaxBoardings > maximumBoundLayers {
+		return
+	}
+	n := len(l.index.data.Stops)
+	l.latestSuffix = make([][]int64, l.query.MaxBoardings+1)
+	latest := make([]int64, n)
+	for s, walk := range l.walkToDestination {
+		latest[s] = -1
+		if walk <= l.query.LatestArrival {
+			latest[s] = l.query.LatestArrival - walk
+		}
+	}
+	l.latestSuffix[0] = latest
+	if l.query.MaxBoardings == 0 {
+		return
+	}
+	l.vehicleSuffixBoardings = make([]uint8, len(l.index.data.Connections))
+	for ci := range l.vehicleSuffixBoardings {
+		l.vehicleSuffixBoardings[ci] = uint8(l.query.MaxBoardings + 1)
+	}
+	for b := 1; b <= l.query.MaxBoardings; b++ {
+		if err := l.ctx.Err(); err != nil {
+			l.err = err
+			return
+		}
+		next := append([]int64(nil), latest...)
+		queue := &latestBoundQueue{}
+		for _, chain := range l.index.chains {
+			canFinish := false
+			for i := len(chain) - 1; i >= 0; i-- {
+				if i&1023 == 0 {
+					if err := l.ctx.Err(); err != nil {
+						l.err = err
+						return
+					}
+				}
+				ci := chain[i]
+				c := l.index.data.Connections[ci]
+				// Staying aboard is independent of this event's pickup/dropoff.
+				canFinish = canFinish || c.Dropoff && c.Arrival <= latest[l.index.stops[c.To]]
+				if !canFinish {
+					continue
+				}
+				l.vehicleSuffixBoardings[ci] = min(l.vehicleSuffixBoardings[ci], uint8(b-1))
+				from := l.index.stops[c.From]
+				if c.Pickup && c.Departure > next[from] {
+					next[from] = c.Departure
+				}
+			}
+		}
+		for stop, at := range next {
+			if at > latest[stop] {
+				heap.Push(queue, boundEntry{stop, at})
+			}
+		}
+		// Multi-source latest-departure propagation is reverse Dijkstra: a
+		// directed u->v walk of d permits readiness at latest[v]-d at u.
+		for queue.Len() > 0 {
+			if err := l.ctx.Err(); err != nil {
+				l.err = err
+				return
+			}
+			u := heap.Pop(queue).(boundEntry)
+			if u.time != next[u.stop] {
+				continue
+			}
+			for _, w := range l.index.incomingWalks[u.stop] {
+				from := l.index.stops[w.From]
+				t := u.time - w.Duration
+				if t > next[from] {
+					next[from] = t
+					heap.Push(queue, boundEntry{from, t})
+				}
+			}
+		}
+		l.latestSuffix[b] = next
+		latest = next
+	}
+}
+
+type latestBoundQueue []boundEntry
+
+func (q latestBoundQueue) Len() int           { return len(q) }
+func (q latestBoundQueue) Less(i, j int) bool { return q[i].time > q[j].time }
+func (q latestBoundQueue) Swap(i, j int)      { q[i], q[j] = q[j], q[i] }
+func (q *latestBoundQueue) Push(x any)        { *q = append(*q, x.(boundEntry)) }
+func (q *latestBoundQueue) Pop() any {
+	old := *q
+	x := old[len(old)-1]
+	*q = old[:len(old)-1]
+	return x
+}
+
+func (l *lane) suffixDeadEnd(stop int, at int64, boards, connection int) bool {
+	if l.latestSuffix == nil {
+		return false
+	}
+	remaining := l.query.MaxBoardings - boards
+	if connection >= 0 {
+		return int(l.vehicleSuffixBoardings[connection]) > remaining
+	}
+	return at > l.latestSuffix[remaining][stop]
+}
