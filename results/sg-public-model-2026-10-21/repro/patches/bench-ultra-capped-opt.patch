--- /dev/null
+++ b/regression/ultra/capped_dense_oracle_test.go
@@ -0,0 +1,85 @@
+package ultra_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/ertyoii/transit-routing-bench/oracle"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/ultra"
+)
+
+// The oracle enumerates the finite model independently of ULTRA/paper route
+// grouping, dense endpoints and cached readiness; compare validated F[b], not
+// journey count or a relaxed aggregate quality metric.
+func TestCappedDenseCompleteTinyOracle(t *testing.T) {
+	checks := 0
+	for seed := uint64(0); seed < 32; seed++ {
+		d := generated(seed)
+		for i := range d.Connections {
+			if i%7 == int(seed%7) {
+				d.Connections[i].Pickup = false
+			}
+			if i%11 == int(seed%11) {
+				d.Connections[i].Dropoff = false
+			}
+		}
+		switch seed % 4 {
+		case 0:
+			d.Transfers = []model.TransferRule{{ID: "zero", FromStop: d.Stops[0].ID, ToStop: d.Stops[1].ID, Type: 0}}
+		case 1:
+			d.Transfers = []model.TransferRule{{ID: "minimum", FromStop: d.Stops[1].ID, ToStop: d.Stops[2].ID, Type: 2, MinSeconds: 6}}
+		case 2:
+			d.Transfers = []model.TransferRule{{ID: "prohibited", FromStop: d.Stops[2].ID, ToStop: d.Stops[0].ID, Type: 3}}
+		}
+		if seed%3 == 0 {
+			d.Stops[len(d.Stops)-1].Accessible = model.No
+			d.Trips[len(d.Trips)-1].Accessible = model.No
+		}
+		for _, accessible := range []bool{false, true} {
+			cfg := ultra.CappedConfig{TransferWalkingLimit: 12, AccessibleOnly: accessible, Limits: limits()}
+			x, e := ultra.BuildCapped(context.Background(), d, cfg)
+			if e != nil {
+				t.Fatal(seed, e)
+			}
+			sparseCfg := ultra.SparseConfig{Capped: cfg, TransferBuffer: 3, MaxProofChecks: 1000000}
+			sx, e := ultra.BuildSparse(context.Background(), d, sparseCfg)
+			if e != nil {
+				t.Fatal(seed, e)
+			}
+			for _, from := range d.Stops {
+				for _, to := range d.Stops {
+					for _, cap := range []int64{0, 3, 12} {
+						q := query(from.ID, to.ID, 0, 18)
+						q.AccessibleOnly = accessible
+						q.TransferBuffer = 3
+						q.Walking = &model.WalkingLimits{Access: cap, Egress: cap, Transfer: cap, Direct: cap}
+						q.MaxWalkSeconds = 1000
+						want, e := oracle.Enumerate(context.Background(), d, q, oracle.Limits{MaxStates: 2000000, MaxJourneys: 1000000})
+						if e != nil || !want.Complete {
+							t.Fatal("complete independent universe required", seed, e)
+						}
+						expected := vectors(t, d, q, want.Journeys)
+						got, e := x.Search(context.Background(), q, limits())
+						if e != nil || !got.Complete {
+							t.Fatal(seed, e)
+						}
+						if actual := vectors(t, d, q, got.Journeys); !reflect.DeepEqual(actual, expected) {
+							t.Fatalf("control seed=%d q=%+v F[b]=%v expected=%v", seed, q, actual, expected)
+						}
+						sg, e := sx.Search(context.Background(), q, limits())
+						if e != nil || !sg.Complete {
+							t.Fatal(seed, e)
+						}
+						if actual := vectors(t, d, q, sg.Journeys); !reflect.DeepEqual(actual, expected) {
+							t.Fatalf("sparse seed=%d q=%+v F[b]=%v expected=%v", seed, q, actual, expected)
+						}
+						checks++
+					}
+				}
+			}
+		}
+	}
+	t.Logf("%d independently enumerated control and sparse F[b] comparisons", checks)
+}
