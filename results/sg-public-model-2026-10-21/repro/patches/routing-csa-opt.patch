@@ -0,0 +1,155 @@
+package csa
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/ertyoii/transit-routing-go/model"
+)
+
+func boundFixture() (model.Dataset, model.Query) {
+	d := model.Dataset{SchemaVersion: model.SchemaVersion, ID: "suffix-bounds", TimeZone: "Asia/Singapore", ServiceDate: "2026-10-20"}
+	for _, id := range []string{"A", "B", "C", "D", "X"} {
+		d.Stops = append(d.Stops, model.Stop{ID: id, Accessible: model.Yes})
+	}
+	d.Trips = []model.Trip{{ID: "through", Accessible: model.Yes}, {ID: "other", Accessible: model.Yes}}
+	d.Connections = []model.Connection{
+		{ID: "z0", TripID: "through", From: "A", To: "X", Departure: 5, Arrival: 5, Pickup: true},
+		{ID: "a1", TripID: "through", Sequence: 1, From: "X", To: "B", Departure: 5, Arrival: 5},
+		{ID: "m2", TripID: "through", Sequence: 2, From: "B", To: "C", Departure: 6, Arrival: 8, Dropoff: true},
+		{ID: "other", TripID: "other", From: "B", To: "D", Departure: 9, Arrival: 10, Pickup: true, Dropoff: true},
+	}
+	d.Footpaths = []model.Footpath{{ID: "egress", From: "C", To: "D", Duration: 2, Accessible: model.Yes}, {ID: "reverse", From: "D", To: "X", Duration: 1, Accessible: model.Yes}}
+	q := model.Query{ID: "q", Origin: "A", Destination: "D", LatestArrival: 10, MaxWalkSeconds: 10, MaxBoardings: 1, MaxLegs: 6}
+	return d, q
+}
+
+func TestSuffixBoundPreservesStayAboardAndDirectedWalking(t *testing.T) {
+	d, q := boundFixture()
+	idx, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := Config{MaxLabels: 100, MaxJourneys: 10, ExactTopK: 10}
+	l, err := idx.newLane(context.Background(), q, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := l.latestSuffix[1][idx.stops["A"]]; got != 5 {
+		t.Fatalf("latest access time=%d, want 5", got)
+	}
+	if got := l.latestSuffix[0][idx.stops["X"]]; got != -1 {
+		t.Fatalf("walking direction reversed: latest X=%d", got)
+	}
+	if got := l.latestSuffix[1][idx.stops["X"]]; got != -1 {
+		t.Fatalf("pickup-prohibited X treated as boardable: %d", got)
+	}
+	r, err := idx.Single(context.Background(), q, cfg)
+	if err != nil || !r.TopKComplete || len(r.Journeys) != 1 || len(r.Journeys[0].Legs) != 4 {
+		t.Fatalf("through journey lost: %+v %v", r, err)
+	}
+	q.LatestArrival = 9
+	r, err = idx.Single(context.Background(), q, cfg)
+	if err != nil || !r.TopKComplete || len(r.Journeys) != 0 || r.Stats.Labels != 1 {
+		t.Fatalf("horizon dead end not certified at origin: %+v %v", r, err)
+	}
+}
+
+func TestSuffixBoundRemovesDeadEndsBeforeLabelBudget(t *testing.T) {
+	d, q := boundFixture()
+	d.Connections = nil
+	d.Trips = nil
+	d.Footpaths = nil
+	for i := 0; i < 30; i++ {
+		id := fmt.Sprintf("branch-%02d", i)
+		d.Trips = append(d.Trips, model.Trip{ID: id, Accessible: model.Yes})
+		d.Connections = append(d.Connections, model.Connection{ID: id, TripID: id, From: "A", To: "B", Departure: 1, Arrival: 2, Pickup: true, Dropoff: true})
+	}
+	idx, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	q.MaxBoardings = 2
+	cfg := Config{MaxLabels: 3, MaxJourneys: 10, ExactTopK: 10}
+	r, err := idx.Single(context.Background(), q, cfg)
+	if err != nil || !r.TopKComplete || r.Stats.Labels != 1 || r.Stats.DeadEndPruned != 1 {
+		t.Fatalf("dead branch allocation: %+v %v", r, err)
+	}
+	// Enumeration mode is unchanged and must still report its actual budget.
+	cfg.ExactTopK = 0
+	r, err = idx.Single(context.Background(), q, cfg)
+	if err == nil || r.Complete || r.Stats.Labels != cfg.MaxLabels {
+		t.Fatalf("enumeration budget contract changed: %+v %v", r, err)
+	}
+}
+
+func TestSuffixBoundSharedOrderAndCapCertificates(t *testing.T) {
+	d, q := boundFixture()
+	idx, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	qs := []model.Query{q, q, q}
+	qs[1].ID, qs[1].Origin = "no-pickup", "X"
+	qs[2].ID, qs[2].LatestArrival = "too-late", 9
+	cfg := Config{MaxLabels: 100, MaxJourneys: 10, ExactTopK: 10}
+	for _, caps := range []bool{false, true} {
+		want := map[string]Result{}
+		for _, q := range qs {
+			var r Result
+			if caps {
+				r, err = idx.StratifiedSingle(context.Background(), q, cfg)
+			} else {
+				r, err = idx.Single(context.Background(), q, cfg)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			want[q.ID] = r
+		}
+		for _, order := range [][]int{{0, 1, 2}, {2, 1, 0}, {1, 0, 2}} {
+			ordered := []model.Query{qs[order[0]], qs[order[1]], qs[order[2]]}
+			var b Batch
+			if caps {
+				b, err = idx.StratifiedShared(context.Background(), ordered, cfg)
+			} else {
+				b, err = idx.Shared(context.Background(), ordered, cfg)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, r := range b.Results {
+				w := want[r.QueryID]
+				if !reflect.DeepEqual(r.Journeys, w.Journeys) || r.Stats != w.Stats || r.TopKComplete != w.TopKComplete || r.CapComplete != w.CapComplete {
+					t.Fatalf("lane order changed certificate or identity: got=%+v want=%+v", r, w)
+				}
+			}
+		}
+	}
+}
+
+func TestSuffixBoundLargeBoardingFallbackAndCancellation(t *testing.T) {
+	d, q := boundFixture()
+	idx, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	q.MaxBoardings, q.MaxLegs = 17, 18
+	cfg := Config{MaxLabels: 100, MaxJourneys: 10, ExactTopK: 10}
+	l, err := idx.newLane(context.Background(), q, cfg)
+	if err != nil || l.latestSuffix != nil {
+		t.Fatalf("large valid query should retain preexisting bounds: %v", err)
+	}
+	r, err := idx.Single(context.Background(), q, cfg)
+	if err != nil || !r.TopKComplete || len(r.Journeys) != 1 {
+		t.Fatalf("fallback changed supported query: %+v %v", r, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	r, err = idx.Single(ctx, q, cfg)
+	if err != context.Canceled || r.TopKComplete {
+		t.Fatalf("cancelled query certified: %+v %v", r, err)
+	}
+}
