+package eacsa
+
+import (
+	"context"
+	"fmt"
+	"math/rand/v2"
+	"reflect"
+	"slices"
+	"sync"
+	"testing"
+
+	"github.com/ertyoii/transit-routing-go/model"
+)
+
+func denseFixture(seed uint64) (model.Dataset, model.Query) {
+	r := rand.New(rand.NewPCG(seed, 4171))
+	d := model.Dataset{SchemaVersion: model.SchemaVersion, ID: "dense-eacsa", TimeZone: "Asia/Singapore", ServiceDate: "2026-10-16"}
+	for _, id := range []string{"Z", "P", "A", "B", "C", "D", "E"} {
+		s := model.Stop{ID: id, Accessible: model.Yes}
+		if id == "P" {
+			s.LocationType = 1
+		}
+		if id == "B" {
+			s.ParentStation = "P"
+		}
+		if id == "C" && seed%3 == 1 {
+			s.Accessible = model.No
+		}
+		d.Stops = append(d.Stops, s)
+	}
+	// Repeated stops, tied departures/arrivals, missed pickups/dropoffs, and a
+	// later connection continuing onboard despite an inaccessible intermediate.
+	routes := [][]string{{"A", "B", "C", "B", "D"}, {"A", "B", "C", "B", "D"}, {"B", "D"}, {"C", "D"}, {"A", "E", "D"}}
+	for ti, stops := range routes {
+		id := fmt.Sprint("t", ti)
+		a := model.Yes
+		if ti == 1 && seed%2 == 1 {
+			a = model.Unknown
+		}
+		d.Trips = append(d.Trips, model.Trip{ID: id, Accessible: a})
+		at := int64(ti*2 + r.IntN(3))
+		for j := 0; j < len(stops)-1; j++ {
+			dep := at
+			at += int64(1 + r.IntN(4))
+			d.Connections = append(d.Connections, model.Connection{ID: fmt.Sprintf("%s-%d", id, j), TripID: id, Sequence: j, From: stops[j], To: stops[j+1], Departure: dep, Arrival: at, Pickup: j == 0 || r.IntN(3) != 0, Dropoff: j == len(stops)-2 || r.IntN(3) != 0})
+		}
+	}
+	// Unused trips must not consume query-local onboard state.
+	d.Trips = append(d.Trips, model.Trip{ID: "unused", Accessible: model.Yes})
+	for i, pair := range [][2]string{{"A", "B"}, {"C", "E"}, {"B", "C"}, {"E", "D"}, {"A", "E"}, {"E", "B"}} {
+		a := model.Yes
+		if i == 4 && seed%2 == 0 {
+			a = model.No
+		}
+		d.Footpaths = append(d.Footpaths, model.Footpath{ID: fmt.Sprint("w", i), From: pair[0], To: pair[1], Duration: int64(1 + r.IntN(4)), Accessible: a})
+	}
+	d.Transfers = []model.TransferRule{{ID: "minimum", FromStop: "P", ToStop: "C", Type: 2, MinSeconds: int64(r.IntN(8))}, {ID: "prohibit", FromStop: "C", ToStop: "B", Type: 3}}
+	r.Shuffle(len(d.Stops), func(i, j int) { d.Stops[i], d.Stops[j] = d.Stops[j], d.Stops[i] })
+	r.Shuffle(len(d.Trips), func(i, j int) { d.Trips[i], d.Trips[j] = d.Trips[j], d.Trips[i] })
+	r.Shuffle(len(d.Connections), func(i, j int) { d.Connections[i], d.Connections[j] = d.Connections[j], d.Connections[i] })
+	q := model.Query{ID: "q", Origin: "A", Destination: "D", Departure: 0, LatestArrival: 40, MaxBoardings: 3, MaxLegs: 128, MaxWalkSeconds: 100, TransferBuffer: int64(r.IntN(3)), Walking: &model.WalkingLimits{Access: 5, Transfer: 5, Egress: 5, Direct: 5}}
+	return d, q
+}
+
+// Compare cancellation at a fixed number of public Context.Err polls instead of
+// a wall clock, to preserve exact partial-result and statistics boundaries.
+type denseCancel struct {
+	context.Context
+	left int
+}
+
+func (c *denseCancel) Err() error {
+	c.left--
+	if c.left <= 0 {
+		return context.Canceled
+	}
+	return nil
+}
+func denseContext(polls int) context.Context {
+	if polls < 0 {
+		return context.Background()
+	}
+	return &denseCancel{context.Background(), polls}
+}
+func denseEqual(t testing.TB, x *Index, q model.Query, polls int) {
+	t.Helper()
+	a, ae := x.frozenSearchV1(denseContext(polls), q)
+	b, be := x.Search(denseContext(polls), q)
+	if !reflect.DeepEqual(a, b) || fmt.Sprint(ae) != fmt.Sprint(be) {
+		t.Fatalf("mismatch q=%+v polls=%d\nold=%+v %v\nnew=%+v %v", q, polls, a, ae, b, be)
+	}
+}
+
+func TestDenseStateFullAndPartialResults(t *testing.T) {
+	for seed := uint64(0); seed < 48; seed++ {
+		d, q := denseFixture(seed)
+		x, err := New(d)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for b := 0; b <= 4; b++ {
+			for _, accessible := range []bool{false, true} {
+				v := q
+				v.MaxBoardings, v.AccessibleOnly = b, accessible
+				for _, caps := range []model.WalkingLimits{{}, {Access: 5, Egress: 5, Transfer: 5, Direct: 5}, {Access: 2, Egress: 7, Transfer: 3, Direct: 1}, {Access: 7, Egress: 0, Transfer: 0, Direct: 7}} {
+					v.Walking = &caps
+					denseEqual(t, x, v, -1)
+				}
+			}
+		}
+		for _, polls := range []int{1, 2, 3, 4, 8, 20, 70, 150, 300, 600, 1200} {
+			denseEqual(t, x, q, polls)
+		}
+		for _, pair := range [][2]string{{"Z", "D"}, {"A", "Z"}, {"B", "C"}, {"A", "A"}, {"missing", "D"}} {
+			v := q
+			v.Origin, v.Destination = pair[0], pair[1]
+			denseEqual(t, x, v, -1)
+		}
+		v := q
+		v.Walking = nil
+		denseEqual(t, x, v, -1)
+		v = q
+		v.MaxLegs = 1
+		denseEqual(t, x, v, -1)
+		v = q
+		v.MaxLegs = 4
+		denseEqual(t, x, v, -1)
+		v = q
+		v.MaxWalkSeconds = 0
+		denseEqual(t, x, v, -1)
+		v = q
+		v.Departure = 5
+		v.LatestArrival = 9
+		denseEqual(t, x, v, -1)
+	}
+}
+
+func TestDenseStateOwnedIndexAndConcurrentQueries(t *testing.T) {
+	d, q := denseFixture(82)
+	x, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old, err := x.Search(context.Background(), q)
+	if err != nil || !old.Complete || len(old.Journeys) == 0 {
+		t.Fatalf("fixture needs output: %v %+v", err, old)
+	}
+	if len(x.tripAccessible) != 5 {
+		t.Fatal("unused trip has an onboard ordinal")
+	}
+	d.Stops[0].ID = "caller-mutated"
+	d.Trips[0].ID = "caller-mutated"
+	d.Connections[0].From = "caller-mutated"
+	d.Footpaths[0].To = "caller-mutated"
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			v := q
+			v.AccessibleOnly = i%2 == 1
+			if i%3 == 1 {
+				v.Origin, v.Destination = "B", "C"
+			}
+			denseEqual(t, x, v, -1)
+		}(i)
+	}
+	wg.Wait()
+	again, err := x.Search(context.Background(), q)
+	if err != nil || !reflect.DeepEqual(old, again) {
+		t.Fatal("owned index changed", err)
+	}
+	d2, q2 := denseFixture(82)
+	slices.Reverse(d2.Stops)
+	slices.Reverse(d2.Trips)
+	slices.Reverse(d2.Connections)
+	y, err := New(d2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	permuted, err := y.Search(context.Background(), q2)
+	if err != nil || !reflect.DeepEqual(old, permuted) {
+		t.Fatal("input order changed output", err)
+	}
+}
+
+func FuzzDenseStateSearch(f *testing.F) {
+	for _, seed := range []uint64{0, 1, 13, 82, 193} {
+		f.Add(seed)
+	}
+	f.Fuzz(func(t *testing.T, seed uint64) {
+		d, q := denseFixture(seed)
+		x, err := New(d)
+		if err != nil {
+			t.Fatal(err)
+		}
+		q.AccessibleOnly = seed%2 == 0
+		q.MaxBoardings = int(seed % 5)
+		denseEqual(t, x, q, -1)
+	})
+}
+
+func TestDenseStateWalkOnlyAndEmptyTimetable(t *testing.T) {
+	d, q := denseFixture(82)
+	d.Connections = nil
+	d.Trips = nil
+	d.Transfers = nil
+	x, err := New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, pair := range [][2]string{{"A", "D"}, {"Z", "D"}, {"P", "D"}, {"A", "A"}} {
+		v := q
+		v.Origin, v.Destination = pair[0], pair[1]
+		for _, polls := range []int{-1, 1, 4, 8, 20, 70} {
+			denseEqual(t, x, v, polls)
+		}
+	}
+}
