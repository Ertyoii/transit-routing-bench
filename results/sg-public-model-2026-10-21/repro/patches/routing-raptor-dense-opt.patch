+	for _, cell := range []walking.Result{matrix.Rows[0][1], matrix.Rows[1][0], matrix.Rows[1][1]} {
+		if cell.Path.Segments[0].Witness.EdgeIDs[0] == "matrix-change" {
+			t.Fatal("duplicate matrix cells alias")
+		}
+	}
+	compareSession(t, g, s, req, nil)
