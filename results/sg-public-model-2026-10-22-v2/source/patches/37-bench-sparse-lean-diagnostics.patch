+package mcraptor_test
+
+import (
+	"context"
+	"github.com/ertyoii/transit-routing-go/ultra"
+	"reflect"
+	"testing"
+)
+
+func TestCappedUltraLocalWalkTiesIndependentWords2D(t *testing.T) {
+	limits := ultra.Limits{MaxRuns: 10000, MaxConnectionVisits: 1000000, MaxWalkSettled: 1000000, MaxWalkEdges: 1000000, MaxShortcuts: 100000, MaxOutputLegs: 1000000}
+	for seed := uint64(0); seed < 96; seed++ {
+		d, q := generated(seed)
+		all := fullWords(d, q, 7)
+		want := objectives(all, q.MaxBoardings)
+		x, e := ultra.BuildCapped(context.Background(), d, ultra.CappedConfig{TransferWalkingLimit: q.Walking.Transfer, AccessibleOnly: q.AccessibleOnly, Limits: limits})
+		if e != nil {
+			t.Fatal(e)
+		}
+		sparse, e := ultra.BuildSparse(context.Background(), d, ultra.SparseConfig{Capped: ultra.CappedConfig{TransferWalkingLimit: q.Walking.Transfer, AccessibleOnly: q.AccessibleOnly, Limits: limits}, TransferBuffer: q.TransferBuffer, MaxProofChecks: 1000000})
+		if e != nil {
+			t.Fatal(e)
+		}
+		sr, e := sparse.SearchLocalWalkTies(context.Background(), q, limits)
+		if e != nil || !sr.Complete {
+			t.Fatal(seed, e, sr)
+		}
+		sg := objectives(metrics(t, d, q, sr.Journeys), q.MaxBoardings)
+		if !reflect.DeepEqual(sg, want) {
+			t.Fatalf("subset seed=%d want=%v got=%v", seed, want, sg)
+		}
+		r, e := x.SearchLocalWalkTies(context.Background(), q, limits)
+		if e != nil || !r.Complete {
+			t.Fatal(seed, e, r)
+		}
+		got := objectives(metrics(t, d, q, r.Journeys), q.MaxBoardings)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("seed=%d want=%v got=%v", seed, want, got)
+		}
+	}
+}
