+				var c0,c1 ultra.SparseCostSummary;json.Unmarshal(summary.Prep.Cost,&c0);json.Unmarshal(summary.Final,&c1);sparseCostParity(t,fullBefore,c0);sparseCostParity(t,fullAfter,c1)
