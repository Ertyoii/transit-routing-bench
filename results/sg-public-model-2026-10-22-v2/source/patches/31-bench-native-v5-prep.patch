+// corechgraphbench audits a supplied public transfer graph; no transit SLA is measured.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"github.com/ertyoii/transit-routing-bench/nativeinputprobe"
+	"math/rand/v2"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"sort"
+	"time"
+
+	"github.com/ertyoii/transit-routing-bench/evaluation"
+	"github.com/ertyoii/transit-routing-bench/experiment"
+	"github.com/ertyoii/transit-routing-bench/fixtures"
+	"github.com/ertyoii/transit-routing-go/corech"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/strictjson"
+)
+
+type record struct {
+	RequestedSource          string   `json:"requested_source"`
+	RequestedTargets         []string `json:"requested_targets"`
+	RequestedMaximumDuration int64    `json:"requested_maximum_duration"`
+	RequestShapeValid        bool     `json:"request_shape_valid"`
+	RequestShapeError        string   `json:"request_shape_error,omitempty"`
+	CoreErrorKind            string   `json:"core_error_kind"`
+	searchError              error
+	Raw                      corech.Row    `json:"raw"`
+	Final                    []corech.Path `json:"final"`
+	Complete                 bool          `json:"complete"`
+	Error                    string        `json:"error,omitempty"`
+	CoreNS                   int64         `json:"core_ns"`
+	ResponseNS               int64         `json:"response_ns"`
+	AllocatedBytes           uint64        `json:"core_allocated_bytes"`
+}
+type pass struct {
+	Algorithm  string   `json:"algorithm"`
+	Repetition int      `json:"repetition"`
+	Warmup     bool     `json:"warmup"`
+	Records    []record `json:"records"`
+}
+type summary struct {
+	Algorithm                string                  `json:"algorithm"`
+	Repetition               int                     `json:"repetition"`
+	Warmup                   bool                    `json:"warmup"`
+	File                     string                  `json:"file"`
+	SHA256                   string                  `json:"sha256"`
+	Rows                     int                     `json:"rows"`
+	Cells                    int                     `json:"cells"`
+	Errors                   int                     `json:"errors"`
+	MakespanNS               int64                   `json:"makespan_ns"`
+	SuccessfulRowsPerSecond  float64                 `json:"successful_rows_per_second"`
+	SuccessfulCellsPerSecond float64                 `json:"successful_cells_per_second"`
+	Core                     evaluation.Distribution `json:"whole_row_core_ns"`
+	Response                 evaluation.Distribution `json:"whole_row_response_ns"`
+	AllocatedBytes           uint64                  `json:"core_allocated_bytes"`
+}
+
+func read(p string, v any, strict bool) (string, error) {
+	b, e := os.ReadFile(p)
+	if e != nil {
+		return "", e
+	}
+	if strict {
+		e = strictjson.Decode(b, v)
+	} else {
+		e = json.Unmarshal(b, v)
+	}
+	return fixtures.Sum(b), e
+}
+
+// validateRequestShape applies to every result, including failed/partial rows.
+// The original requested denominator is never inferred from returned paths.
+func validateRequestShape(r corech.Row, source string, targets []string, maximum int64) error {
+	if r.Source != source || r.MaximumDuration != maximum {
+		return fmt.Errorf("row source/cap identity differs")
+	}
+	if len(r.Paths) != len(targets) {
+		return fmt.Errorf("target denominator differs")
+	}
+	for i, p := range r.Paths {
+		if p.Target != targets[i] {
+			return fmt.Errorf("target identity/order differs")
+		}
+	}
+	return nil
+}
+
+func coreErrorKind(err error) string {
+	if err == nil {
+		return "none"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "context_deadline_exceeded"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "context_canceled"
+	}
+	return "other_search_error"
+}
+
+// assessRow always checks request binding/shape. A failed raw row and all partial
+// paths remain diagnostic only; they are never promoted into final witnesses.
+func assessRow(r corech.Row, searchErr, budgetErr error, source string, targets []string, maximum int64, raw map[string]model.Footpath, want map[string]map[string]int64) record {
+	shapeErr := validateRequestShape(r, source, targets, maximum)
+	var witnessErr error
+	if searchErr == nil && budgetErr == nil {
+		witnessErr = validate(r, source, targets, maximum, raw, want)
+	}
+	err := errors.Join(searchErr, budgetErr, shapeErr, witnessErr)
+	rec := record{Raw: r, Final: []corech.Path{}, RequestedSource: source, RequestedTargets: append([]string{}, targets...), RequestedMaximumDuration: maximum, RequestShapeValid: shapeErr == nil, CoreErrorKind: coreErrorKind(searchErr), searchError: searchErr, Complete: err == nil}
+	if shapeErr != nil {
+		rec.RequestShapeError = shapeErr.Error()
+	}
+	if err != nil {
+		rec.Error = err.Error()
+	} else {
+		rec.Final = r.Paths
+	}
+	return rec
+}
+
+// A generic incomplete/error record is not evidence of a forced deadline.
+// Require a real SearchMany context error, an incomplete raw result, preserved
+// request shape and no accepted final/partial witnesses. Error text is not used.
+func expectedDeadlineFailure(r record, source string, targets []string, maximum int64) bool {
+	return !r.Complete && !r.Raw.Complete && len(r.Final) == 0 && r.Error != "" && r.RequestShapeValid && r.RequestShapeError == "" && r.RequestedSource == source && r.RequestedMaximumDuration == maximum && slices.Equal(r.RequestedTargets, targets) && validateRequestShape(r.Raw, source, targets, maximum) == nil && (errors.Is(r.searchError, context.DeadlineExceeded) || errors.Is(r.searchError, context.Canceled)) && r.CoreErrorKind == coreErrorKind(r.searchError)
+}
+
+// This validator follows supplied original-edge IDs and consults independently
+// audited expected distances. It does not use the contraction or search code.
+func validate(r corech.Row, source string, targets []string, maximum int64, raw map[string]model.Footpath, want map[string]map[string]int64) error {
+	if err := validateRequestShape(r, source, targets, maximum); err != nil {
+		return err
+	}
+	if want[source] == nil {
+		return fmt.Errorf("missing independent source audit")
+	}
+	if !r.Complete || r.Error != "" {
+		return fmt.Errorf("incomplete row: %s", r.Error)
+	}
+	for _, p := range r.Paths {
+		cost, found := want[r.Source][p.Target]
+		if r.Source == p.Target {
+			cost, found = 0, true
+		}
+		if p.Found != found || found && p.Duration != cost {
+			return fmt.Errorf("audited distance differs: %s -> %s: got %v/%d want %v/%d", r.Source, p.Target, p.Found, p.Duration, found, cost)
+		}
+		if !found {
+			if len(p.RawEdges) > 0 || len(p.CoreArcs) > 0 {
+				return fmt.Errorf("unreachable cell has path")
+			}
+			continue
+		}
+		at, sum := r.Source, int64(0)
+		for _, id := range p.RawEdges {
+			e, ok := raw[id]
+			if !ok || e.From != at {
+				return fmt.Errorf("invalid raw witness edge %q", id)
+			}
+			at = e.To
+			if e.Duration <= 0 || e.Duration > maximum-sum {
+				return fmt.Errorf("raw witness exceeds cap")
+			}
+			sum += e.Duration
+		}
+		if at != p.Target || sum != p.Duration || sum > r.MaximumDuration {
+			return fmt.Errorf("raw witness endpoint/duration mismatch")
+		}
+	}
+	return nil
+}
+func run() error {
+	inputOnly := flag.Bool("input-only", false, "parse and bind exact consuming-driver inputs; no constructor or search")
+	dp := flag.String("dataset", "", "explicit normalized public dataset; only stops and positive directed footpaths are measured")
+	qp := flag.String("queries", "", "hash-bound tune point workload; distinct OD endpoints become protected row anchors")
+	maximum := flag.Int64("maximum-duration", 600, "whole-row transfer distance cap in seconds")
+	out := flag.String("out-dir", "", "new output directory")
+	reps := flag.Int("repetitions", 3, "measured repetitions")
+	warmups := flag.Int("warmups", 1, "retained warmups")
+	prepTimeout := flag.Duration("prep-timeout", 180*time.Second, "cooperative preparation deadline")
+	timeout := flag.Duration("timeout", 5*time.Second, "whole row core deadline")
+	localWitness := flag.Int("witness-settled", 128, "per-search conservative witness limit")
+	globalSettled := flag.Int("max-witness-settled", 30000000, "global witness settled limit; exhaustion fails")
+	globalEdges := flag.Int("max-witness-edges", 150000000, "global witness edge limit; exhaustion fails")
+	maxDegree := flag.Float64("maximum-average-core-out-degree", 14, "natural partial contraction stop")
+	hardware := flag.String("hardware", "unrecorded", "verified hardware description")
+	flag.Parse()
+	if *dp == "" || *qp == "" || *out == "" || *maximum < 0 || *maximum >= corech.Infinity || *reps < 1 || *warmups < 0 || *prepTimeout <= 0 || *timeout <= 0 {
+		return fmt.Errorf("invalid arguments")
+	}
