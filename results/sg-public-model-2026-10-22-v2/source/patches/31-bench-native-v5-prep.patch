+)
+
+func edge(id, from, to string, duration int64) model.Footpath {
+	return model.Footpath{ID: id, From: from, To: to, Duration: duration}
+}
+
+func TestIndependentAuditKnownDirectedCapCases(t *testing.T) {
+	vertices := []string{"A", "B", "C", "D"}
+	// Deliberately reversed path order, parallel edges, a self loop and a disconnected vertex.
+	edges := []model.Footpath{edge("bc", "B", "C", 3), edge("ab-slow", "A", "B", 8), edge("ab", "A", "B", 2), edge("cc", "C", "C", 1)}
+	got, _, err := auditDistances(context.Background(), vertices, edges, []string{"A", "C", "D"}, 5)
+	want := map[string]map[string]int64{"A": {"A": 0, "B": 2, "C": 5}, "C": {"C": 0}, "D": {"D": 0}}
+	if err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v err %v", got, err)
+	}
+	got, _, err = auditDistances(context.Background(), vertices, edges, []string{"A"}, 4)
+	if err != nil || !reflect.DeepEqual(got, map[string]map[string]int64{"A": {"A": 0, "B": 2}}) {
+		t.Fatalf("cap got %v err %v", got, err)
+	}
+	got, _, err = auditDistances(context.Background(), vertices, edges, []string{"A"}, 0)
+	if err != nil || !reflect.DeepEqual(got, map[string]map[string]int64{"A": {"A": 0}}) {
+		t.Fatalf("zero cap got %v err %v", got, err)
+	}
+}
+
+// This independent Floyd-Warshall corpus checks every directed 3-node graph
+// whose six possible edges are absent or have weight 1 or 2 (729 graphs).
+func TestAuditAgainstIndependentFloydCorpus(t *testing.T) {
+	vertices := []string{"A", "B", "C"}
+	for code := 0; code < 729; code++ {
+		value := code
+		var edges []model.Footpath
+		d := [3][3]int64{{0, 99, 99}, {99, 0, 99}, {99, 99, 0}}
+		for i := 0; i < 3; i++ {
+			for j := 0; j < 3; j++ {
+				if i == j {
+					continue
+				}
+				weight := value % 3
+				value /= 3
+				if weight > 0 {
+					edges = append(edges, edge(vertices[i]+vertices[j], vertices[i], vertices[j], int64(weight)))
+					d[i][j] = int64(weight)
+				}
+			}
+		}
+		for k := 0; k < 3; k++ {
+			for i := 0; i < 3; i++ {
+				for j := 0; j < 3; j++ {
+					if d[i][k]+d[k][j] < d[i][j] {
+						d[i][j] = d[i][k] + d[k][j]
+					}
+				}
+			}
+		}
+		for _, cap := range []int64{0, 1, 2, 4} {
+			got, _, err := auditDistances(context.Background(), vertices, edges, vertices, cap)
+			if err != nil {
+				t.Fatal(code, cap, err)
+			}
+			for i, from := range vertices {
+				for j, to := range vertices {
+					want := d[i][j] <= cap
+					distance, found := got[from][to]
+					if found != want || found && distance != d[i][j] {
+						t.Fatalf("graph %d cap %d %s->%s got %d/%v want %d/%v", code, cap, from, to, distance, found, d[i][j], want)
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestAuditRejectsInvalidAndCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	for _, tc := range []struct {
+		ctx      context.Context
+		vertices []string
+		edges    []model.Footpath
+		sources  []string
+		cap      int64
+	}{
+		{ctx, []string{"A"}, nil, []string{"A"}, 5},
+		{context.Background(), []string{"A"}, nil, []string{"Z"}, 5},
+		{context.Background(), []string{"A", "A"}, nil, []string{"A"}, 5},
+		{context.Background(), []string{"A"}, []model.Footpath{edge("bad", "A", "Z", 1)}, []string{"A"}, 5},
+		{context.Background(), []string{"A"}, []model.Footpath{edge("bad", "A", "A", 0)}, []string{"A"}, 5},
+		{context.Background(), []string{"A"}, nil, []string{"A"}, -1},
+	} {
+		if _, _, err := auditDistances(tc.ctx, tc.vertices, tc.edges, tc.sources, tc.cap); err == nil {
+			t.Fatal("invalid audit accepted", tc)
+		}
+	}
+}
+
+func TestValidatorRetainsExactDenominatorAndWitness(t *testing.T) {
+	raw := map[string]model.Footpath{"ab": edge("ab", "A", "B", 2)}
+	want := map[string]map[string]int64{"A": {"A": 0, "B": 2}}
+	valid := corech.Row{Source: "A", MaximumDuration: 5, Complete: true, Paths: []corech.Path{{Target: "A", Found: true}, {Target: "B", Found: true, Duration: 2, RawEdges: []string{"ab"}}, {Target: "C"}}}
+	targets := []string{"A", "B", "C"}
+	if err := validate(valid, "A", targets, 5, raw, want); err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*corech.Row){
+		func(r *corech.Row) { r.Paths = r.Paths[:2] },
+		func(r *corech.Row) { r.Source = "Z" },
+		func(r *corech.Row) { r.MaximumDuration = 6 },
+		func(r *corech.Row) { r.Complete = false },
+		func(r *corech.Row) { r.Error = "failed" },
+		func(r *corech.Row) { r.Paths[1].Target = "C" },
+		func(r *corech.Row) { r.Paths[1].Duration = 1 },
+		func(r *corech.Row) { r.Paths[1].Found = false },
+		func(r *corech.Row) { r.Paths[1].RawEdges = []string{"unknown"} },
+		func(r *corech.Row) { r.Paths[1].RawEdges = []string{"ab", "ab"} },
+		func(r *corech.Row) { r.Paths[2].RawEdges = []string{"ab"} },
+	} {
+		changed := valid
+		changed.Paths = append([]corech.Path{}, valid.Paths...)
+		mutate(&changed)
+		if validate(changed, "A", targets, 5, raw, want) == nil {
+			t.Fatal("mutation accepted", changed)
+		}
+	}
+}
+
+// Failed rows must preserve the original request even when their raw paths are
+// only diagnostic and are intentionally not accepted as complete witnesses.
+func TestFailedRowsRetainExactBindingAndDenominator(t *testing.T) {
+	targets := []string{"A", "B", "C"}
+	failed := corech.Row{Source: "A", MaximumDuration: 5, Complete: false, Error: context.DeadlineExceeded.Error(), Paths: []corech.Path{{Target: "A"}, {Target: "B", Found: true, RawEdges: []string{"partial-not-a-witness"}}, {Target: "C"}}}
+	good := assessRow(failed, context.DeadlineExceeded, nil, "A", targets, 5, nil, nil)
+	if good.Complete || !good.RequestShapeValid || len(good.Final) != 0 || !expectedDeadlineFailure(good, "A", targets, 5) || good.RequestedSource != "A" || good.RequestedMaximumDuration != 5 || !reflect.DeepEqual(good.RequestedTargets, targets) {
+		t.Fatal("honest failed row rejected/promoted", good)
+	}
+	for _, mutate := range []func(*corech.Row){
+		func(r *corech.Row) { r.Paths = r.Paths[:2] },
+		func(r *corech.Row) { r.Paths = append(r.Paths, corech.Path{Target: "D"}) },
+		func(r *corech.Row) { r.Paths[0], r.Paths[1] = r.Paths[1], r.Paths[0] },
+		func(r *corech.Row) { r.Paths[1].Target = "A" },
+		func(r *corech.Row) { r.Source = "B" },
+		func(r *corech.Row) { r.MaximumDuration = 6 },
+	} {
+		changed := failed
+		changed.Paths = append([]corech.Path{}, failed.Paths...)
+		mutate(&changed)
+		rec := assessRow(changed, context.DeadlineExceeded, nil, "A", targets, 5, nil, nil)
+		if rec.Complete || rec.RequestShapeValid || rec.RequestShapeError == "" || len(rec.Final) != 0 || expectedDeadlineFailure(rec, "A", targets, 5) || len(rec.RequestedTargets) != len(targets) {
+			t.Fatal("malformed failed request accepted", rec)
+		}
+	}
+}
+
+func TestForcedDeadlineRequiresGenuineContextError(t *testing.T) {
+	targets := []string{"A", "B"}
+	failed := corech.Row{Source: "A", MaximumDuration: 5, Complete: false, Error: "diagnostic", Paths: []corech.Path{{Target: "A"}, {Target: "B"}}}
+	for _, err := range []error{context.DeadlineExceeded, context.Canceled, fmt.Errorf("wrapped search: %w", context.DeadlineExceeded), errors.Join(fmt.Errorf("detail"), context.Canceled)} {
+		rec := assessRow(failed, err, nil, "A", targets, 5, nil, nil)
+		if !expectedDeadlineFailure(rec, "A", targets, 5) {
+			t.Fatal("real context failure rejected", rec)
+		}
+	}
+	for _, err := range []error{nil, fmt.Errorf("edge budget exhausted"), fmt.Errorf("context deadline exceeded"), fmt.Errorf("context canceled")} {
+		rec := assessRow(failed, err, nil, "A", targets, 5, nil, nil)
+		if expectedDeadlineFailure(rec, "A", targets, 5) {
+			t.Fatal("non-context forced failure accepted", rec)
+		}
+	}
+	// An over-budget driver observation is not a genuine SearchMany context error.
+	rec := assessRow(failed, nil, context.DeadlineExceeded, "A", targets, 5, nil, nil)
+	if expectedDeadlineFailure(rec, "A", targets, 5) {
+		t.Fatal("cooperative budget observation accepted as native context error", rec)
+	}
+	genuine := assessRow(failed, context.DeadlineExceeded, nil, "A", targets, 5, nil, nil)
+	for _, mutate := range []func(*record){
+		func(r *record) { r.Complete = true },
+		func(r *record) { r.Raw.Complete = true },
+		func(r *record) { r.Final = []corech.Path{{Target: "A"}} },
+		func(r *record) { r.CoreErrorKind = "other_search_error" },
+		func(r *record) { r.RequestShapeValid = false },
+		func(r *record) { r.Error = "" },
+		func(r *record) { r.RequestShapeError = "shape failed" },
+		func(r *record) { r.RequestedSource = "B" },
+		func(r *record) { r.RequestedMaximumDuration = 6 },
+		func(r *record) { r.RequestedTargets = []string{"B", "A"} },
+	} {
+		changed := genuine
+		mutate(&changed)
+		if expectedDeadlineFailure(changed, "A", targets, 5) {
+			t.Fatal("wrong forced-failure metadata accepted", changed)
+		}
+	}
+}
+
+func TestCanceledPreparationRejectionHasExactShape(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	cfg := corech.Config{TargetCoreVertices: 2, MaximumAverageCoreOutDegree: 14, WitnessSettledPerSearch: 128, MaxContractions: 10, MaxArcs: 100, MaxWitnessSettled: 100, MaxWitnessEdges: 100}
+	index, err := corech.Build(ctx, []string{"A", "B"}, []model.Footpath{edge("ab", "A", "B", 2)}, []string{"A", "B"}, cfg)
+	if !errors.Is(err, context.Canceled) || index.Complete() {
+		t.Fatal("canceled build not rejected", err)
+	}
+	targets := []string{"A", "B"}
+	rejected, err := index.SearchMany(context.Background(), "A", targets, 5, corech.QueryLimits{MaxSettled: 10, MaxEdges: 100, MaxUnpackedEdges: 100})
+	if err == nil || rejected.Complete || validateRequestShape(rejected, "A", targets, 5) != nil {
+		t.Fatal("rejected query lost binding/denominator", rejected, err)
+	}
+	rejected.Paths[0], rejected.Paths[1] = rejected.Paths[1], rejected.Paths[0]
+	if validateRequestShape(rejected, "A", targets, 5) == nil {
+		t.Fatal("reordered canceled-prep targets accepted")
+	}
+}
