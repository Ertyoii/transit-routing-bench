+package main
+
+import (
+	"context"
+	"fmt"
+	"github.com/ertyoii/transit-routing-go/model"
+)
+
+type pointWorkload struct {
+	Seed          uint64 `json:"seed"`
+	Method        string `json:"method"`
+	DatasetSHA256 string `json:"dataset_sha256"`
+	Items         []struct {
+		Stratum string      `json:"stratum"`
+		Query   model.Query `json:"query"`
+	} `json:"items"`
+}
+
+// auditDistances is independent of Core-CH. Positive raw edges are relaxed to
+// a fixed point; values above the finite cap are deliberately unreachable.
+func auditDistances(ctx context.Context, vertices []string, edges []model.Footpath, sources []string, cap int64) (map[string]map[string]int64, map[string]int, error) {
+	if cap < 0 {
+		return nil, nil, fmt.Errorf("negative cap")
+	}
+	known := map[string]bool{}
+	for _, v := range vertices {
+		if v == "" || known[v] {
+			return nil, nil, fmt.Errorf("bad vertex")
+		}
+		known[v] = true
+	}
+	for _, e := range edges {
+		if !known[e.From] || !known[e.To] || e.Duration <= 0 {
+			return nil, nil, fmt.Errorf("invalid edge")
+		}
+	}
+	result, passes := map[string]map[string]int64{}, map[string]int{}
+	for _, source := range sources {
+		if !known[source] {
+			return nil, nil, fmt.Errorf("unknown source")
+		}
+		distances := map[string]int64{source: 0}
+		complete := false
+		for pass := 0; pass < len(vertices); pass++ {
+			if e := ctx.Err(); e != nil {
+				return nil, nil, e
+			}
+			changed := false
+			for i, edge := range edges {
+				if i%1024 == 0 {
+					if e := ctx.Err(); e != nil {
+						return nil, nil, e
+					}
+				}
+				d, ok := distances[edge.From]
+				// Subtraction avoids overflow even on malformed extreme inputs.
+				if !ok || edge.Duration > cap-d {
+					continue
+				}
+				candidate := d + edge.Duration
+				old, exists := distances[edge.To]
+				if !exists || candidate < old {
+					distances[edge.To] = candidate
+					changed = true
+				}
+			}
+			passes[source]++
+			if !changed {
+				complete = true
+				break
+			}
+		}
+		if !complete {
+			return nil, nil, fmt.Errorf("no fixed point after vertex bound")
+		}
+		result[source] = distances
+	}
+	return result, passes, nil
+}
