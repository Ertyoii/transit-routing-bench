+package workloadseed
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"math"
+	"math/rand/v2"
+	"strings"
+	"testing"
+)
+
+func TestNumericExactAndRNG(t *testing.T) {
+	for _, tc := range []struct {
+		j string
+		v uint64
+	}{{"0", 0}, {"1", 1}, {"9007199254740993", 9007199254740993}, {"18446744073709551615", math.MaxUint64}} {
+		var s Seed
+		if e := json.Unmarshal([]byte(tc.j), &s); e != nil || s.Uint64() != tc.v {
+			t.Fatalf("%s %v %v", tc.j, s, e)
+		}
+		b, _ := json.Marshal(s)
+		if string(b) != tc.j {
+			t.Fatal(string(b))
+		}
+		a := rand.NewPCG(s.Uint64(), 17)
+		bRNG := rand.NewPCG(tc.v, 17)
+		for i := 0; i < 10; i++ {
+			if a.Uint64() != bRNG.Uint64() {
+				t.Fatal("numeric RNG changed")
+			}
+		}
+	}
+}
+func TestTextMapping(t *testing.T) {
+	var a, b, c, d Seed
+	for _, s := range []struct {
+		j string
+		p *Seed
+	}{{`"alpha"`, &a}, {`"alpha"`, &b}, {`"beta"`, &c}, {`"1"`, &d}} {
+		if e := json.Unmarshal([]byte(s.j), s.p); e != nil {
+			t.Fatal(e)
+		}
+	}
+	h := sha256.Sum256([]byte(Domain + "alpha"))
+	if a.Uint64() != binary.BigEndian.Uint64(h[:8]) || a != b || a.Uint64() == c.Uint64() || d.Uint64() == 1 {
+		t.Fatal("mapping mismatch")
+	}
+	m := a.Metadata()
+	if m.SourceText != "alpha" || m.Mapping != MappingVersion || string(m.SourceJSON) != `"alpha"` {
+		t.Fatal(m)
+	}
+}
+func TestRejectInvalid(t *testing.T) {
+	for _, j := range []string{`-1`, `-0`, `1.0`, `1e0`, `+1`, `00`, `01`, `18446744073709551616`, `true`, `false`, `null`, `[]`, `{}`, `""`, `" "`, `"a b"`, `"a\nb"`, `"\ud800"`, `"\udc00"`, `"\ud800\u0041"`, `"\x"`, `"unterminated`, `"` + strings.Repeat("x", 257) + `"`, string([]byte{'"', 255, '"'})} {
+		var s Seed
+		if e := json.Unmarshal([]byte(j), &s); e == nil {
+			t.Errorf("accepted %q", j)
+		}
+	}
+}
+func TestUnicodePolicy(t *testing.T) {
+	var a, b, c, d Seed
+	for _, x := range []struct {
+		j string
+		s *Seed
+	}{{`"é"`, &a}, {`"\u00e9"`, &b}, {`"e\u0301"`, &c}, {`"\ud83d\ude00"`, &d}} {
+		if e := json.Unmarshal([]byte(x.j), x.s); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if a.Uint64() != b.Uint64() || a.Uint64() == c.Uint64() {
+		t.Fatal("Unicode normalization policy")
+	}
+	var max Seed
+	if e := json.Unmarshal([]byte(`"`+strings.Repeat("é", 128)+`"`), &max); e != nil {
+		t.Fatal(e)
+	}
+}
+func TestMissingDefaultsAndFailedDecodeAtomic(t *testing.T) {
+	var w struct {
+		Seed Seed `json:"seed"`
+	}
+	if e := json.Unmarshal([]byte(`{}`), &w); e != nil || w.Seed.Uint64() != 0 || w.Seed.Metadata().SourceKind != "missing_legacy_default_zero" {
+		t.Fatal(w, e)
+	}
+	s := Numeric(9)
+	if e := s.UnmarshalJSON([]byte(`null`)); e == nil || s.Uint64() != 9 {
+		t.Fatal("failed mutation")
+	}
+}
