+// Package workloadseed preserves legacy numeric seeds and gives textual seed
+// identifiers an explicit, reproducible, non-security uint64 mapping.
+package workloadseed
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"unicode"
+	"unicode/utf8"
+)
+
+const MaxTextBytes = 256
+const MappingVersion = "sha256-first64be-text-seed-v1"
+
+// Domain is hashed byte-for-byte before the decoded, unnormalized UTF-8 text.
+const Domain = "transit-routing-bench/workload-seed/text/v1\x00"
+
+type Seed struct {
+	value   uint64
+	raw     string
+	text    string
+	present bool
+	textual bool
+}
+type Metadata struct {
+	SourceKind    string          `json:"source_kind"`
+	SourceJSON    json.RawMessage `json:"source_json,omitempty"`
+	SourceText    string          `json:"source_text,omitempty"`
+	Mapping       string          `json:"mapping"`
+	Domain        string          `json:"domain,omitempty"`
+	UnicodePolicy string          `json:"unicode_policy,omitempty"`
+	Uint64        uint64          `json:"uint64"`
+}
+
+func Numeric(v uint64) Seed   { return Seed{value: v, raw: strconv.FormatUint(v, 10), present: true} }
+func (s Seed) Uint64() uint64 { return s.value }
+
+// Summary seed remains a JSON number for numeric-output backward compatibility.
+// Call Metadata alongside it so textual provenance never disappears.
+func (s Seed) MarshalJSON() ([]byte, error) { return []byte(strconv.FormatUint(s.value, 10)), nil }
+func (s Seed) Metadata() Metadata {
+	m := Metadata{SourceKind: "missing_legacy_default_zero", Mapping: "identity-uint64-v1", Uint64: s.value}
+	if s.present {
+		m.SourceKind = "uint64"
+		m.SourceJSON = json.RawMessage(s.raw)
+	}
+	if s.textual {
+		m.SourceKind = "text"
+		m.SourceText = s.text
+		m.Mapping = MappingVersion
+		m.Domain = Domain
+		m.UnicodePolicy = "exact UTF-8; no normalization; nonempty; <=256 decoded bytes; no Unicode whitespace or control characters"
+	}
+	return m
+}
+func (s *Seed) UnmarshalJSON(data []byte) error {
+	raw := bytes.TrimSpace(data)
+	if len(raw) == 0 {
+		return fmt.Errorf("seed: empty JSON")
+	}
+	var next Seed
+	if raw[0] == '"' {
+		if !utf8.Valid(raw) {
+			return fmt.Errorf("seed: invalid UTF-8")
+		}
+		if err := checkSurrogates(raw); err != nil {
+			return err
+		}
+		var id string
+		if err := json.Unmarshal(raw, &id); err != nil {
+			return fmt.Errorf("seed: %w", err)
+		}
+		if len(id) == 0 || len(id) > MaxTextBytes {
+			return fmt.Errorf("seed: text must contain 1..%d UTF-8 bytes", MaxTextBytes)
+		}
+		for _, r := range id {
+			if unicode.IsSpace(r) || unicode.IsControl(r) {
+				return fmt.Errorf("seed: whitespace/control in textual identifier")
+			}
+		}
+		sum := sha256.Sum256(append([]byte(Domain), []byte(id)...))
+		next = Seed{value: binary.BigEndian.Uint64(sum[:8]), raw: string(raw), text: id, present: true, textual: true}
+	} else {
+		// Do not route numbers through float64. Only canonical JSON uint64 decimals
+		// are accepted; signs, exponent notation, fractions and overflow are errors.
+		if len(raw) > 1 && raw[0] == '0' {
+			return fmt.Errorf("seed: noncanonical uint64")
+		}
+		for _, c := range raw {
+			if c < '0' || c > '9' {
+				return fmt.Errorf("seed: expected canonical uint64 or textual identifier")
+			}
+		}
+		v, err := strconv.ParseUint(string(raw), 10, 64)
+		if err != nil {
+			return fmt.Errorf("seed: %w", err)
+		}
+		next = Numeric(v)
+	}
+	*s = next
+	return nil
+}
+
+// encoding/json replaces unpaired UTF-16 surrogates with U+FFFD. Reject those
+// malformed identifiers instead of silently changing their hash identity.
+func checkSurrogates(raw []byte) error {
+	for i := 1; i < len(raw)-1; i++ {
+		if raw[i] != '\\' {
+			continue
+		}
+		i++
+		if i >= len(raw)-1 {
+			return fmt.Errorf("seed: malformed string escape")
+		}
+		if raw[i] != 'u' {
+			continue
+		}
+		if i+4 >= len(raw) {
+			return fmt.Errorf("seed: malformed Unicode escape")
+		}
+		code, e := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)
+		if e != nil {
+			return fmt.Errorf("seed: malformed Unicode escape")
+		}
+		i += 4
+		if code >= 0xD800 && code <= 0xDBFF {
+			if i+6 >= len(raw) || raw[i+1] != '\\' || raw[i+2] != 'u' {
+				return fmt.Errorf("seed: unpaired high surrogate")
+			}
+			low, e := strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)
+			if e != nil || low < 0xDC00 || low > 0xDFFF {
+				return fmt.Errorf("seed: unpaired high surrogate")
+			}
+			i += 6
+		} else if code >= 0xDC00 && code <= 0xDFFF {
+			return fmt.Errorf("seed: unpaired low surrogate")
+		}
+	}
+	return nil
+}
