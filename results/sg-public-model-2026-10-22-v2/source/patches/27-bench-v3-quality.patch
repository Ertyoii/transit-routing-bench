@@ -0,0 +1,232 @@
+// inputpreflight strictly validates exact input bytes, query bounds/endpoints,
+// hashes and configuration schemas. It never constructs or invokes a router.
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"github.com/ertyoii/transit-routing-bench/workloadseed"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/profilequery"
+	"github.com/ertyoii/transit-routing-go/recommend"
+	"github.com/ertyoii/transit-routing-go/strictjson"
+	"os"
+)
+
+type pointItem struct {
+	Stratum string      `json:"stratum"`
+	Query   model.Query `json:"query"`
+}
+type pointWorkload struct {
+	Seed          workloadseed.Seed `json:"seed"`
+	Method        string            `json:"method"`
+	DatasetSHA256 string            `json:"dataset_sha256"`
+	Items         []pointItem       `json:"items"`
+}
+type profileItem struct {
+	Stratum string             `json:"stratum"`
+	Query   profilequery.Query `json:"query"`
+}
+type profileWorkload struct {
+	Seed          workloadseed.Seed `json:"seed"`
+	Method        string            `json:"method"`
+	DatasetSHA256 string            `json:"dataset_sha256"`
+	Items         []profileItem     `json:"items"`
+}
+type request struct {
+	ID           string `json:"id"`
+	Dataset      string `json:"dataset"`
+	Queries      string `json:"queries"`
+	Schema       string `json:"schema"`
+	Algorithm    string `json:"algorithm,omitempty"`
+	Preferences  string `json:"preferences,omitempty"`
+	ScopedConfig string `json:"scoped_config,omitempty"`
+	ReadySpan    int64  `json:"ready_span_seconds"`
+	MaxWindow    int64  `json:"max_window_seconds"`
+}
+type result struct {
+	ID                string                `json:"id"`
+	Accepted          bool                  `json:"accepted"`
+	Error             string                `json:"error,omitempty"`
+	Schema            string                `json:"schema"`
+	DatasetSHA256     string                `json:"dataset_sha256,omitempty"`
+	QueriesSHA256     string                `json:"queries_sha256,omitempty"`
+	Queries           int                   `json:"query_count"`
+	Seed              workloadseed.Metadata `json:"seed_metadata"`
+	PreferencesSHA256 string                `json:"preferences_sha256,omitempty"`
+	ScopedSHA256      string                `json:"scoped_config_sha256,omitempty"`
+	Scope             string                `json:"scope"`
+}
+type loadedDataset struct {
+	value     model.Dataset
+	hash      string
+	validator *model.QueryValidator
+}
+
+func sum(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+func read(p string, v any) (string, error) {
+	b, e := os.ReadFile(p)
+	if e != nil {
+		return "", e
+	}
+	if e = strictjson.Decode(b, v); e != nil {
+		return "", e
+	}
+	return sum(b), nil
+}
+func load(p string) (*loadedDataset, error) {
+	var d model.Dataset
+	hash, e := read(p, &d)
+	if e != nil {
+		return nil, e
+	}
+	if e = d.Validate(); e != nil {
+		return nil, e
+	}
+	return &loadedDataset{d, hash, model.NewQueryValidator(d)}, nil
+}
+func check(r request, d *loadedDataset) (out result) {
+	out = result{ID: r.ID, Schema: r.Schema, DatasetSHA256: d.hash, Scope: "input_only_no_routing_no_outcomes"}
+	fail := func(e error) result { out.Error = e.Error(); return out }
+	if r.Schema == "" {
+		r.Schema = "point"
+		out.Schema = r.Schema
+	}
+	if r.MaxWindow < 0 || r.ReadySpan < 0 {
+		return fail(fmt.Errorf("negative profile bounds"))
+	}
+	b, e := os.ReadFile(r.Queries)
+	if e != nil {
+		return fail(e)
+	}
+	out.QueriesSHA256 = sum(b)
+	queries := []profilequery.Query{}
+	var bound string
+	switch r.Schema {
+	case "point", "profile-from-point":
+		var w pointWorkload
+		if e = strictjson.Decode(b, &w); e != nil {
+			return fail(e)
+		}
+		bound = w.DatasetSHA256
+		out.Seed = w.Seed.Metadata()
+		for _, i := range w.Items {
+			q := profilequery.Query{Base: i.Query, End: i.Query.Departure}
+			if r.Schema == "profile-from-point" {
+				if r.ReadySpan > i.Query.LatestArrival-i.Query.Departure {
+					return fail(fmt.Errorf("ready span exceeds fixed horizon: %s", i.Query.ID))
+				}
+				q.End += r.ReadySpan
+			}
+			queries = append(queries, q)
+		}
+	case "profile":
+		var w profileWorkload
+		if e = strictjson.Decode(b, &w); e != nil {
+			return fail(e)
+		}
+		bound = w.DatasetSHA256
+		out.Seed = w.Seed.Metadata()
+		for _, i := range w.Items {
+			queries = append(queries, i.Query)
+		}
+	default:
+		return fail(fmt.Errorf("unsupported input schema %q", r.Schema))
+	}
+	if bound != d.hash || len(queries) == 0 {
+		return fail(fmt.Errorf("workload dataset hash differs or workload empty"))
+	}
+	seen := map[string]bool{}
+	for _, q := range queries {
+		if seen[q.Base.ID] {
+			return fail(fmt.Errorf("duplicate query %q", q.Base.ID))
+		}
+		seen[q.Base.ID] = true
+		if e = d.validator.Validate(q.Base); e != nil {
+			return fail(e)
+		}
+		if r.Schema != "point" && (q.End < q.Base.Departure || q.End > q.Base.LatestArrival || q.End-q.Base.Departure > r.MaxWindow) {
+			return fail(fmt.Errorf("invalid or over-budget verification window: %s", q.Base.ID))
+		}
+	}
+	out.Queries = len(queries)
+	if r.Preferences != "" {
+		var c recommend.ChoiceConfig
+		out.PreferencesSHA256, e = read(r.Preferences, &c)
+		if e != nil {
+			return fail(fmt.Errorf("preferences: %w", e))
+		}
+		if e = c.Validate(); e != nil {
+			return fail(fmt.Errorf("preferences: %w", e))
+		}
+	}
+	if r.ScopedConfig != "" {
+		var c scopedConfig
+		out.ScopedSHA256, e = read(r.ScopedConfig, &c)
+		if e != nil {
+			return fail(fmt.Errorf("scoped: %w", e))
+		}
+		if e = validateScopedInput(d.value, r.Algorithm, c); e != nil {
+			return fail(fmt.Errorf("scoped: %w", e))
+		}
+	} else if isScoped(r.Algorithm) {
+		return fail(fmt.Errorf("scoped adapter requires scoped configuration"))
+	}
+	out.Accepted = true
+	return out
+}
+func main() {
+	dataset := flag.String("dataset", "", "exact normalized dataset")
+	queries := flag.String("queries", "", "exact workload bytes")
+	schema := flag.String("schema", "point", "point, profile or profile-from-point")
+	manifest := flag.String("manifest", "", "strict JSON request array; reuses validated datasets")
+	algorithm := flag.String("algorithm", "", "selected adapter")
+	prefs := flag.String("preferences", "", "exact preference scenarios")
+	scoped := flag.String("scoped-config", "", "exact scoped config")
+	span := flag.Int64("ready-span-seconds", 60, "inclusive derived ready span")
+	maxspan := flag.Int64("max-window-seconds", 600, "complete profile verification bound")
+	flag.Parse()
+	var requests []request
+	if *manifest != "" {
+		if _, e := read(*manifest, &requests); e != nil {
+			fmt.Fprintln(os.Stderr, e)
+			os.Exit(2)
+		}
+	} else {
+		requests = []request{{Dataset: *dataset, Queries: *queries, Schema: *schema, Algorithm: *algorithm, Preferences: *prefs, ScopedConfig: *scoped, ReadySpan: *span, MaxWindow: *maxspan}}
+	}
+	if len(requests) == 0 {
+		fmt.Fprintln(os.Stderr, "empty input manifest")
+		os.Exit(2)
+	}
+	cache := map[string]*loadedDataset{}
+	enc := json.NewEncoder(os.Stdout)
+	failed := false
+	for _, r := range requests {
+		d := cache[r.Dataset]
+		if d == nil {
+			var e error
+			d, e = load(r.Dataset)
+			if e != nil {
+				enc.Encode(result{ID: r.ID, Schema: r.Schema, Error: e.Error(), Scope: "input_only_no_routing_no_outcomes"})
+				failed = true
+				continue
+			}
+			cache[r.Dataset] = d
+		}
+		out := check(r, d)
+		if !out.Accepted {
+			failed = true
+		}
+		if e := enc.Encode(out); e != nil {
+			fmt.Fprintln(os.Stderr, e)
+			os.Exit(2)
+		}
+	}
+	if failed {
+		os.Exit(1)
+	}
+}
