+package main
+
+import (
+	"fmt"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/tripbased"
+	"github.com/ertyoii/transit-routing-go/ultra"
+)
+
+// scopedConfig is explicit experiment input. It has no hidden production-sized
+// defaults and never derives a looser walking cap from the query roster.
+type scopedConfig struct {
+	TripBased            *tripbased.Config                           `json:"trip_based,omitempty"`
+	Flash                *tripbased.FlashConfig                      `json:"flash,omitempty"`
+	Sparse               *ultra.SparseConfig                         `json:"ultra_sparse,omitempty"`
+	ULTRA                *ultra.CappedConfig                         `json:"ultra,omitempty"`
+	ULTRAQuery           *ultra.Limits                               `json:"ultra_query,omitempty"`
+	Patterns             *tripbased.DestinationCappedPatternConfig   `json:"patterns,omitempty"`
+	TREX                 *tripbased.TREXConfig                       `json:"trex,omitempty"`
+	Verify               *tripbased.TREXStaticCapVerifyLimits        `json:"verification,omitempty"`
+	SourceDomainPatterns *tripbased.DestinationSourceDomainConfig    `json:"source_domain_patterns,omitempty"`
+	TFixedTransferCap    *int64                                      `json:"trex_fixed_transfer_cap,omitempty"`
+	VerifyPreparation    *tripbased.TREXRawVerifierPreparationLimits `json:"verification_preparation,omitempty"`
+}
+
+var scopedNames = []string{
+	"trip_based_capped",
+	"ultra_transfer_complete_capped",
+	"ultra_capped_local_walk_ties",
+	"ultra_subset_local_walk_ties",
+	"ultra_cap_safe_stay_witness_subset_v1",
+	"flash_tb_static_stop_pair_suffix_flags_role_caps_v1",
+	"tp_destination_fixed_caps_experimental",
+	"trex_static_caps_mandatory_verified_experimental",
+	tpSourceDomainName,
+	trexDefinedProbeName,
+}
+
+func isScoped(name string) bool {
+	for _, v := range scopedNames {
+		if name == v {
+			return true
+		}
+	}
+	return false
+}
+
+const tpSourceDomainName = "tp_source_domain_retained_fixed_caps_experimental_v1"
+const trexDefinedProbeName = "trex_fixed_transfer_cap_ranked_defined_probe_verified_experimental_v1"
+
+// New policy fields cannot silently change the meaning of a legacy adapter.
+func validateQualificationV2Selection(name string, c scopedConfig) error {
+	if c.SourceDomainPatterns != nil && name != tpSourceDomainName {
+		return fmt.Errorf("source_domain_patterns requires %s", tpSourceDomainName)
+	}
+	if (c.TFixedTransferCap != nil || c.VerifyPreparation != nil) && name != trexDefinedProbeName {
+		return fmt.Errorf("fixed transfer cap and verifier preparation require %s", trexDefinedProbeName)
+	}
+	if name == tpSourceDomainName && c.SourceDomainPatterns == nil {
+		return fmt.Errorf("source_domain_patterns configuration required")
+	}
+	if name == trexDefinedProbeName && (c.TREX == nil || c.Verify == nil || c.TFixedTransferCap == nil || c.VerifyPreparation == nil) {
+		return fmt.Errorf("trex, verification, trex_fixed_transfer_cap and verification_preparation configurations required")
+	}
+	return nil
+}
+
+// Validate settings whose owning constructor may inspect them only after an
+// earlier resource decline. This is configuration validation, not preprocessing
+// or a replacement for the library's dataset/capability checks. Keep these
+// exposed configuration requirements aligned with the pinned vendor contract.
+func validateScopedPreparation(d model.Dataset, c scopedConfig) error {
+	if c.SourceDomainPatterns != nil {
+		v := c.SourceDomainPatterns.Retained
+		if err := validateFlashPreparation(d, v.Scope.Patterns.Profile); err != nil {
+			return err
+		}
+		if v.MaxPendingSegments <= 0 || v.MaxSourceSeeds <= 0 {
+			return fmt.Errorf("positive retained source-domain preparation limits required")
+		}
+	}
+	if c.TFixedTransferCap != nil && *c.TFixedTransferCap < 0 {
+		return fmt.Errorf("fixed transfer walking cap must be nonnegative")
+	}
+	if c.VerifyPreparation != nil {
+		v := *c.VerifyPreparation
+		if v.MaxRows <= 0 || v.MaxWork <= 0 || v.MaxPayloadBytes <= 0 {
+			return fmt.Errorf("positive raw verifier preparation limits required")
+		}
+	}
+	if c.Flash != nil {
+		if err := validateFlashPreparation(d, *c.Flash); err != nil {
+			return err
+		}
+	}
+	if c.Patterns != nil {
+		if err := validateFlashPreparation(d, c.Patterns.Patterns.Profile); err != nil {
+			return err
+		}
+	}
+	if c.ULTRAQuery != nil {
+		l := *c.ULTRAQuery
+		if !positiveULTRALimits(l) {
+			return fmt.Errorf("positive ULTRA query limits required")
+		}
+	}
+	if c.Verify != nil && (c.Verify.MaxStates <= 0 || c.Verify.MaxJourneys <= 0 || c.Verify.MaxScans <= 0) {
+		return fmt.Errorf("positive verification limits required")
+	}
+	if c.TREX != nil && len(c.TREX.Partition) > 0 {
+		p := c.TREX.Partition
+		if c.TREX.Levels < 0 || c.TREX.Levels > 12 {
+			return fmt.Errorf("invalid T-REX partition levels")
+		}
+		if len(p) != len(d.Stops) {
+			return fmt.Errorf("invalid T-REX partition: must cover exactly all stops")
+		}
+		used := make([]bool, 1<<uint(c.TREX.Levels))
+		for _, s := range d.Stops {
+			leaf, ok := p[s.ID]
+			if !ok || leaf < 0 || leaf >= len(used) {
+				return fmt.Errorf("invalid T-REX partition leaf")
+			}
+			used[leaf] = true
+		}
+		for _, present := range used {
+			if !present {
+				return fmt.Errorf("invalid T-REX partition: empty leaf")
+			}
+		}
+		// Endpoints in the same leaf imply their entire weak walking component
+		// is unsplit; no routing or partition-construction logic is shared here.
+		for _, edge := range d.Footpaths {
+			if p[edge.From] != p[edge.To] {
+				return fmt.Errorf("invalid T-REX partition: cuts a walking component")
+			}
+		}
+	}
+	return nil
+}
+
+func positiveULTRALimits(l ultra.Limits) bool {
+	return l.MaxRuns > 0 && l.MaxConnectionVisits > 0 && l.MaxWalkSettled > 0 && l.MaxWalkEdges > 0 && l.MaxShortcuts > 0 && l.MaxOutputLegs > 0
+}
+
+func validateFlashPreparation(d model.Dataset, c tripbased.FlashConfig) error {
+	l := c.Limits
+	if c.Cells < 1 || c.Cells > len(d.Stops) || c.MaxBoardings < 1 || c.MaxBoardings > 32 || l.MaxStops < 1 || l.MaxTrips < 1 || l.MaxClosurePaths < 1 || l.MaxWalkSettled < 1 || l.MaxTransfers < 1 || l.MaxRuns < 1 || l.MaxWork < 1 || l.MaxFlagBytes < 1 || l.MaxWitnesses < 1 || l.MaxQuerySegments < 1 {
+		return fmt.Errorf("invalid FLASH preparation configuration: positive configuration/budgets required")
+	}
+	if c.Semantics == "static_stop_pair_v1" && (l.MaxSuffixBytes <= 0 || l.MaxSnapshotTransfers <= 0) {
+		return fmt.Errorf("invalid FLASH preparation configuration: positive suffix-state byte and snapshot-record budgets required")
+	}
+	return nil
+}
+
+// Static input checks only. No constructor or graph preprocessing is called.
+func validateScopedInput(d model.Dataset, name string, c scopedConfig) error {
+	if !isScoped(name) {
+		return fmt.Errorf("scoped configuration supplied for non-scoped adapter %q", name)
+	}
+	present := 0
+	for _, yes := range []bool{c.TripBased != nil, c.Flash != nil, c.Sparse != nil, c.ULTRA != nil, c.Patterns != nil, c.TREX != nil, c.SourceDomainPatterns != nil} {
+		if yes {
+			present++
+		}
+	}
+	if present != 1 {
+		return fmt.Errorf("scoped config requires exactly one algorithm configuration")
+	}
+	if e := validateQualificationV2Selection(name, c); e != nil {
+		return e
+	}
+	if (c.ULTRAQuery != nil && c.ULTRA == nil && c.Sparse == nil) || (c.Verify != nil && c.TREX == nil) {
+		return fmt.Errorf("query/verification config mismatches selected algorithm")
+	}
+	switch name {
+	case "trip_based_capped":
+		if c.TripBased == nil {
+			return fmt.Errorf("trip_based required")
+		}
+	case "flash_tb_static_stop_pair_suffix_flags_role_caps_v1":
+		if c.Flash == nil {
+			return fmt.Errorf("flash required")
+		}
+	case "ultra_transfer_complete_capped", "ultra_capped_local_walk_ties":
+		if c.ULTRA == nil || c.ULTRAQuery == nil {
+			return fmt.Errorf("ultra and ultra_query required")
+		}
+	case "ultra_cap_safe_stay_witness_subset_v1", "ultra_subset_local_walk_ties":
+		if c.Sparse == nil || c.ULTRAQuery == nil {
+			return fmt.Errorf("ultra_sparse and ultra_query required")
+		}
+	case "tp_destination_fixed_caps_experimental":
+		if c.Patterns == nil {
+			return fmt.Errorf("patterns required")
+		}
+	case "trex_static_caps_mandatory_verified_experimental":
+		if c.TREX == nil || c.Verify == nil {
+			return fmt.Errorf("trex and verification required")
+		}
+	}
+	return validateScopedPreparation(d, c)
+}
