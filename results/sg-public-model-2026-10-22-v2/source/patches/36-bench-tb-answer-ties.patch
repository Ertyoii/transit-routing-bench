+						}
+						if at > q.LatestArrival {
+							continue
+						}
+						if w.To == q.Destination {
+							if w.Duration <= q.Walking.Egress {
+								if err = addAnswer(multiAnswer{at, l.walk + w.Duration, boards, l.parent}, w, c.Arrival); err != nil {
