+package main
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/tripbased"
+	"github.com/ertyoii/transit-routing-go/validate"
+)
+
+func tbAnswerFixture() (model.Dataset, model.Query, scopedConfig) {
+	d := model.Dataset{SchemaVersion: model.SchemaVersion, ID: "tb-answer-ties-adapter", TimeZone: "Asia/Singapore", ServiceDate: "2026-10-21"}
+	for _, id := range []string{"B", "C", "D"} {
+		d.Stops = append(d.Stops, model.Stop{ID: id, Accessible: model.Yes})
+	}
+	d.Footpaths = []model.Footpath{{ID: "access", From: "C", To: "B", Duration: 5, Accessible: model.Yes}}
+	for _, v := range []struct {
+		id, from string
+		dep      int64
+	}{{"walking-first", "B", 10}, {"seated-tie", "C", 0}} {
+		d.Trips = append(d.Trips, model.Trip{ID: v.id, Accessible: model.Yes})
+		d.Connections = append(d.Connections, model.Connection{ID: v.id, TripID: v.id, From: v.from, To: "D", Departure: v.dep, Arrival: 20, Pickup: true, Dropoff: true})
+	}
+	q := model.Query{ID: "q", Origin: "C", Destination: "D", LatestArrival: 30, MaxBoardings: 2, MaxLegs: 64, MaxWalkSeconds: 25, Walking: &model.WalkingLimits{Access: 5, Transfer: 5, Egress: 5, Direct: 5}}
+	c := scopedConfig{TripBased: &tripbased.Config{TransferWalkingLimit: 5, MaxTransfers: 100, MaxQueuedSegments: 100}}
+	return d, q, c
+}
+
+func TestTBAnswerWalkTiesNamedAdapterLiteralAnswer(t *testing.T) {
+	const name = "trip_based_capped_answer_walk_ties"
+	d, q, cfg := tbAnswerFixture()
+	if !isScoped(name) {
+		t.Fatal("new candidate name is not registered")
+	}
+	checker, err := validate.New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		walk int64
+	}{{"trip_based_capped", 5}, {name, 0}} {
+		r, err := prepareScoped(context.Background(), d, tc.name, cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := r.single(context.Background(), q)
+		if got.Err != nil || !got.Complete || len(got.Journeys) != 1 {
+			t.Fatal(got)
+		}
+		v, err := checker.Check(q, got.Journeys[0])
+		if err != nil || v.Metrics.Arrival != 20 || v.Metrics.Boardings != 1 || v.Metrics.WalkingSeconds != tc.walk {
+			t.Fatal(tc.name, err, v, got)
+		}
+		if tc.name == name {
+			b, err := json.Marshal(r.config)
+			if err != nil || !strings.Contains(string(b), `"minimum_walking_representatives_complete":false`) || !strings.Contains(string(b), "answer_only") || !strings.Contains(string(b), "native_reached_position") {
+				t.Fatal("local-only contract metadata missing", err, string(b))
+			}
+			if got.Journeys[0].Legs[0].Ref != "seated-tie" {
+				t.Fatal("wrong literal witness", got.Journeys)
+			}
+		}
+		prep := r.cost()
+		if _, ok := prep.(tripbased.Preparation); !ok {
+			t.Fatal("native preparation accounting hidden", prep)
+		}
+		if v := r.single(context.Background(), q); !reflect.DeepEqual(v.Journeys, got.Journeys) || v.Err != nil {
+			t.Fatal("unstable adapter", v, got)
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		if v := r.single(ctx, q); v.Complete || v.Err == nil {
+			t.Fatal("adapter hid cancellation", v)
+		}
+	}
+}
+
+func TestTBAnswerWalkTiesNamedAdapterRetainedReachedLoss(t *testing.T) {
+	d, q, cfg := tbAnswerFixture()
+	d.Trips = []model.Trip{{ID: "same-trip", Accessible: model.Yes}}
+	d.Connections = []model.Connection{
+		{ID: "bc", TripID: "same-trip", Sequence: 0, From: "B", To: "C", Departure: 5, Arrival: 6, Pickup: true, Dropoff: true},
+		{ID: "cd", TripID: "same-trip", Sequence: 1, From: "C", To: "D", Departure: 7, Arrival: 10, Pickup: true, Dropoff: true},
+	}
+	d.Footpaths[0].Duration = 3
+	q.MaxBoardings = 1
+	r, err := prepareScoped(context.Background(), d, "trip_based_capped_answer_walk_ties", cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := r.single(context.Background(), q)
+	if got.Err != nil || !got.Complete || len(got.Journeys) != 1 {
+		t.Fatal(got)
+	}
+	checker, err := validate.New(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := checker.Check(q, got.Journeys[0])
+	if err != nil || v.Metrics.Arrival != 10 || v.Metrics.Boardings != 1 || v.Metrics.WalkingSeconds != 3 {
+		t.Fatal("native reached limitation not retained", err, v)
+	}
+	zeroWalk := model.Journey{Legs: []model.Leg{{Kind: "ride", Ref: "cd", Departure: 7, Arrival: 10}}}
+	v, err = checker.Check(q, zeroWalk)
+	if err != nil || v.Metrics.Arrival != 10 || v.Metrics.Boardings != 1 || v.Metrics.WalkingSeconds != 0 {
+		t.Fatal("literal feasible lower-walk alternative missing", err, v)
+	}
+}
