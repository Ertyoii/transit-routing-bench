+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPreflightTBAnswerWalkTiesExactConfig(t *testing.T) {
+	d, r, raw := testInput(t)
+	r.Algorithm = "trip_based_capped_answer_walk_ties"
+	if !isScoped(r.Algorithm) {
+		t.Fatal("new adapter absent from parser registration")
+	}
+	if got := check(r, d); got.Accepted || !strings.Contains(got.Error, "requires scoped configuration") {
+		t.Fatal("missing scope accepted", got)
+	}
+	r.ScopedConfig = filepath.Join(t.TempDir(), "tb-answer-ties.json")
+	const valid = `{"trip_based":{"strict_line_order":true,"transfer_walking_limit":600,"transfer_buffer":0,"accessible_only":false,"max_precomputed_transfers":5000000,"max_queued_segments":1000000}}`
+	if err := os.WriteFile(r.ScopedConfig, []byte(valid), 0600); err != nil {
+		t.Fatal(err)
+	}
+	got := check(r, d)
+	if !got.Accepted || got.ScopedSHA256 != sum([]byte(valid)) || got.QueriesSHA256 != sum([]byte(raw)) || got.Scope != "input_only_no_routing_no_outcomes" {
+		t.Fatal("exact valid new adapter input rejected", got)
+	}
+	r.Algorithm = "trip_based_capped"
+	base := check(r, d)
+	if !base.Accepted || base.ScopedSHA256 != got.ScopedSHA256 || base.QueriesSHA256 != got.QueriesSHA256 {
+		t.Fatal("baseline parser config meaning changed", base, got)
+	}
+	r.Algorithm = "trip_based_capped_answer_walk_ties"
+	for _, s := range []string{
+		`{}`,
+		`{"trip_based":{"max_precomputed_transfers":1,"max_queued_segments":1},"flash":{}}`,
+		`{"ultra":{}}`,
+		strings.Replace(valid, `"strict_line_order":true`, `"unexpected":true`, 1),
+		strings.Replace(valid, `"trip_based":`, `"trip_based":{},"TRIP_BASED":`, 1),
+	} {
+		if err := os.WriteFile(r.ScopedConfig, []byte(s), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if invalid := check(r, d); invalid.Accepted {
+			t.Fatal("invalid new adapter input accepted", s, invalid)
+		}
+	}
+	// Existing inputpreflight is an input/schema check, not constructor
+	// execution. Constructor-only TB budget guards remain fail-closed during
+	// actual preparation; preserve exact baseline parser behavior here.
+	for _, constructorOnly := range []string{`{"trip_based":{}}`, strings.Replace(valid, `"max_queued_segments":1000000`, `"max_queued_segments":0`, 1)} {
+		if err := os.WriteFile(r.ScopedConfig, []byte(constructorOnly), 0600); err != nil {
+			t.Fatal(err)
+		}
+		r.Algorithm = "trip_based_capped"
+		base := check(r, d)
+		r.Algorithm = "trip_based_capped_answer_walk_ties"
+		candidate := check(r, d)
+		if !base.Accepted || !candidate.Accepted || base.ScopedSHA256 != candidate.ScopedSHA256 {
+			t.Fatal("constructor-only guard parser behavior differs", base, candidate)
+		}
+	}
+	after, err := os.ReadFile(r.Queries)
+	if err != nil || string(after) != raw {
+		t.Fatal("input-only parser modified workload", err)
+	}
+}
