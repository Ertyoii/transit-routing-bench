+		for _, old := range bag {
+			out.Stats.DominanceChecks++
+			if old.time <= c.time && old.walk <= c.walk {
+				return bag, false, nil
+			}
+		}
+		if e := spend(); e != nil {
+			return bag, false, e
+		}
+		kept := bag[:0]
+		for _, old := range bag {
+			if !(c.time <= old.time && c.walk <= old.walk) {
+				kept = append(kept, old)
+			}
+		}
