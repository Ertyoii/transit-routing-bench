+func BenchmarkNodeWitnessAllocation(b *testing.B) {
+	c := model.Connection{ID: "ride", Departure: 3, Arrival: 7}
+	for _, slabs := range []bool{false, true} {
+		name := "individual"
+		if slabs {
+			name = "slabs"
+		}
+		b.Run(name, func(b *testing.B) {
+			b.ReportAllocs()
+			for n := 0; n < b.N; n++ {
+				var a NodeArena
+				var p *Node
+				for i := 0; i < 4096; i++ {
+					if slabs {
+						p = a.Ride(p, c)
+					} else {
+						p = Ride(p, c)
+					}
+				}
+				runtime.KeepAlive(p)
+			}
+		})
+	}
