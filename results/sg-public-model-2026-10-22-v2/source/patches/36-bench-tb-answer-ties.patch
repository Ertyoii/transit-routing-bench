+		x := &FlashIndex{names: names, ids: map[string]int{}, cfg: FlashConfig{Limits: FlashLimits{MaxWork: 10000, MaxWalkSettled: 1000, MaxClosurePaths: 1000}}}
+		for i, name := range names {
