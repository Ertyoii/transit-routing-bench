+	cfg := MultiConfig{EarlyPruning: early, Criterion: "walking_seconds", MaxLabels: labels, MaxConnectionVisits: connections}
+	am, ae := x.frozenMultiV1(denseContext(polls), q, cfg)
+	bm, be := x.SearchMulti(denseContext(polls), q, cfg)
