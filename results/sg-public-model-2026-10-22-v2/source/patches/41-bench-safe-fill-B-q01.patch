+package main
+// STATIC STAGING ONLY. Source-bound offline feature CLI, never serving timing.
+import("context";"encoding/json";"fmt";"io";"os";"github.com/ertyoii/transit-routing-go/recommend";"github.com/ertyoii/transit-routing-bench/experiment")
+func main(){dec:=json.NewDecoder(os.Stdin);dec.DisallowUnknownFields();enc:=json.NewEncoder(os.Stdout);seen:=map[string]bool{};for{var q struct{ID string `json:"request_id"`;Features []recommend.Feature `json:"features"`;Config recommend.HybridFillConfig `json:"config"`};err:=dec.Decode(&q);if err==io.EOF{return};if err!=nil{fmt.Fprintln(os.Stderr,err);os.Exit(2)};if q.ID==""||seen[q.ID]{fmt.Fprintln(os.Stderr,"duplicate/empty request ID");os.Exit(2)};seen[q.ID]=true;r,e:=recommend.SelectHybridFill(context.Background(),q.Features,q.Config);message:="";if e!=nil{message=e.Error()};var control *recommend.ContinuousChoices;controlError:="";if e==nil{var ce error;control,ce=recommend.SelectBounded(context.Background(),q.Features,q.Config.Base);if ce!=nil{controlError=ce.Error()}};if err=enc.Encode(map[string]any{"request_id":q.ID,"result":r,"error":message,"base_control":control,"base_control_error":controlError,"build_source_sha256":experiment.BuildSourceSHA256});err!=nil{fmt.Fprintln(os.Stderr,err);os.Exit(2)}}}
