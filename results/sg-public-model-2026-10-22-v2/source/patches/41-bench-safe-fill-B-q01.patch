+package regression
+// STATIC STAGING ONLY. Source/serving qualification on a literal tiny model.
+import("context";"testing";"github.com/ertyoii/transit-routing-go/model";"github.com/ertyoii/transit-routing-go/recommend";"github.com/ertyoii/transit-routing-go/validate")
+func fillServingConfig(k int)recommend.ChoiceConfig{safe:=safeServingConfig("absolute");finite:=safe.FiniteSafe.Baseline;finite.DeliveryLimits=[]int{k};base:=recommend.ChoiceConfig{MaxCandidates:1024,MaxSubsets:200000,Bounded:&recommend.BoundedConfig{MinTransfer:0,MaxTransfer:900,MinWalk:0,MaxWalk:4,Objective:"absolute",Limits:[]int{k},MaxCriticalPoints:100000,MaxWork:50000000,MaxMatrixBytes:67108864,ExactWhenFeasible:true}};fill:=&recommend.HybridFillConfig{Base:base,Finite20:finite,MaxFillSubsets:200000,MaxFillWork:20000000,MaxFillMatrixBytes:8388608};return recommend.ChoiceConfig{MaxCandidates:1024,MaxSubsets:200000,LeanDelivery:true,DeliveryPolicy:"bounded_absolute_hybrid_fill_v1",DeliveryLimits:[]int{k},HybridFill:fill}}
+func TestHybridFillLeanServingExactTop3Top5AndBasePrefix(t *testing.T){d:=model.Dataset{SchemaVersion:"0.2",ID:"fill-lean-toy",TimeZone:"Asia/Singapore",ServiceDate:"2026-10-20",Stops:[]model.Stop{{ID:"a",Accessible:model.Yes},{ID:"b",Accessible:model.Yes}},Trips:[]model.Trip{{ID:"t1",RouteID:"r1",Accessible:model.Yes},{ID:"t2",RouteID:"r2",Accessible:model.Yes},{ID:"t3",RouteID:"r3",Accessible:model.Yes}},Connections:[]model.Connection{{ID:"c1",TripID:"t1",From:"a",To:"b",Departure:10,Arrival:20,Pickup:true,Dropoff:true},{ID:"c2",TripID:"t2",From:"a",To:"b",Departure:10,Arrival:30,Pickup:true,Dropoff:true},{ID:"c3",TripID:"t3",From:"a",To:"b",Departure:10,Arrival:40,Pickup:true,Dropoff:true}},Footpaths:[]model.Footpath{}};checker,err:=validate.New(d);if err!=nil{t.Fatal(err)};lean,err:=recommend.NewBoundedFromChecker(checker);if err!=nil{t.Fatal(err)};q:=model.Query{ID:"q",Origin:"a",Destination:"b",Departure:0,LatestArrival:100,MaxBoardings:1,MaxLegs:3};js:=[]model.Journey{{Legs:[]model.Leg{{Kind:"ride",Ref:"c1",Departure:10,Arrival:20}}},{Legs:[]model.Leg{{Kind:"ride",Ref:"c2",Departure:10,Arrival:30}}},{Legs:[]model.Leg{{Kind:"ride",Ref:"c3",Departure:10,Arrival:40}}}};for _,k:=range []int{3,5}{out,e:=lean.EvaluateChoices(context.Background(),q,js,fillServingConfig(k));if e!=nil||out.HybridFillChoices==nil||!out.HybridFillChoices.Complete||out.FiniteSafeChoices!=nil||out.ContinuousChoices!=nil||out.Choices!=nil||len(out.Selections)!=0{t.Fatalf("serving dispatch or controls %+v %v",out,e)};r:=out.HybridFillChoices;if !r.FillRequired||r.Selection.Limit!=k||len(r.Selection.Selected)!=3||len(r.Selection.BaseSelected)!=1||r.Selection.Selected[0]!=r.Selection.BaseSelected[0]||r.Selection.FilledSubsetOptimalClaim{t.Fatalf("inclusion/cardinality failed %+v",r)}}}
