+func logSparseBuildAdmission(t *testing.T, stage string) {
+	t.Helper()
+	observed := map[string]string{}
+	for _, path := range []string{"/proc/meminfo", "/proc/self/limits", "/proc/self/cgroup", "/sys/fs/cgroup/memory.current", "/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory.events"} {
+		value, e := os.ReadFile(path)
+		if e != nil {
+			observed[path] = "unavailable: " + e.Error()
+		} else {
+			observed[path] = string(value)
+		}
+	}
+	t.Logf("actual memory/limits before %s: %+v", stage, observed)
+	if dir := os.Getenv("SPARSE_QUALIFICATION_EVIDENCE_DIR"); dir != "" {
+		payload, e := json.MarshalIndent(observed, "", "  ")
+		if e != nil {
+			t.Fatal(e)
+		}
+		f, e := os.OpenFile(filepath.Join(dir, stage+".json"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if e != nil {
+			t.Fatal(e)
+		}
+		_, e = f.Write(append(payload, '\n'))
+		ce := f.Close()
+		if e != nil {
+			t.Fatal(e)
+		}
+		if ce != nil {
+			t.Fatal(ce)
+		}
+	}
+}
