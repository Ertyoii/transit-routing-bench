+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/presentation"
+)
+
+type shortStream struct{}
+
+func (shortStream) Write(p []byte) (int, error) { return len(p) - 1, nil }
+
+type brokenStream struct{}
+
+func (brokenStream) Write(p []byte) (int, error) { return 0, errors.New("sink unavailable") }
+
+func TestResponsePublisherActualAnswerAndFirstCompleteMarker(t *testing.T) {
+	var answers, marker bytes.Buffer
+	begin := time.Now().Add(-time.Second)
+	p := responsePublisher{answers: &answers, marker: &marker, processStarted: begin}
+	failed := record{item: item{Query: model.Query{ID: "failed"}}, Attempted: true, Status: "deadline", Final: []model.Validated{}, Display: map[int]presentation.Result{}}
+	if e := p.publish(&failed, begin); e != nil {
+		t.Fatal(e)
+	}
+	if marker.Len() != 0 || p.first != nil {
+		t.Fatal("failed outcome is not an available successful answer")
+	}
+	valid := model.Validated{Journey: model.Journey{Legs: []model.Leg{{Kind: "ride", Ref: "c", Departure: 2, Arrival: 5}}}}
+	z := record{item: item{Query: model.Query{ID: "answer"}}, Completed: true, Attempted: true, Status: "complete", Final: []model.Validated{valid}, Display: map[int]presentation.Result{}, ResponseNS: 42}
+	if e := p.publish(&z, begin); e != nil {
+		t.Fatal(e)
+	}
+	if z.PublishedResponseNS == nil || *z.PublishedResponseNS <= 42 || z.SerializationNS == nil || *z.SerializationNS < 0 {
+		t.Fatal("publication timing missing", z)
+	}
+	var a availableAnswer
+	lines := strings.Split(strings.TrimSpace(answers.String()), "\n")
+	if len(lines) != 2 {
+		t.Fatal("not incremental JSONL", answers.String())
+	}
+	if e := json.Unmarshal([]byte(lines[1]), &a); e != nil {
+		t.Fatal(e)
+	}
+	if !a.Completed || a.Query.ID != "answer" || len(a.Final) != 1 || a.Final[0].Journey.Legs[0].Ref != "c" || a.ResponseNS != 42 {
+		t.Fatal("missing actual validated witness", a)
+	}
+	var m availableMarker
+	if e := json.Unmarshal(bytes.TrimSpace(marker.Bytes()), &m); e != nil {
+		t.Fatal(e)
+	}
+	if m.Event != "first_available_answer" || m.QueryID != "answer" || m.ProcessElapsedNS <= 0 || m.AvailableUTC == "" {
+		t.Fatal("invalid availability marker", m)
+	}
+	old := marker.String()
+	if e := p.publish(&z, begin); e != nil {
+		t.Fatal(e)
+	}
+	if marker.String() != old {
+		t.Fatal("first marker repeated")
+	}
+	if p.summary()["records"] != 3 {
+		t.Fatal("stream count")
+	}
+	var off *responsePublisher
+	if off.summary()["enabled"] != false {
+		t.Fatal("disabled publisher")
+	}
+}
+
+func TestResponsePublisherWriteFailuresNeverClaimAvailability(t *testing.T) {
+	z := record{item: item{Query: model.Query{ID: "answer"}}, Completed: true, Attempted: true, Status: "complete"}
+	for _, sink := range []io.Writer{shortStream{}, brokenStream{}} {
+		var marker bytes.Buffer
+		p := responsePublisher{answers: sink, marker: &marker, processStarted: time.Now()}
+		if e := p.publish(&z, time.Now()); e == nil {
+			t.Fatal("ignored failed stream")
+		}
+		if marker.Len() != 0 || p.first != nil || p.records != 0 {
+			t.Fatal("reported unavailable write")
+		}
+	}
+}
+
+func TestResponseStreamProcessBoundary(t *testing.T) {
+	root, e := filepath.Abs("../..")
+	if e != nil {
+		t.Fatal(e)
+	}
+	env := append(os.Environ(), "GOTOOLCHAIN=local", "GOWORK=off", "GOPROXY=off", "GOSUMDB=off", "GOMAXPROCS=2")
+	binary := filepath.Join(t.TempDir(), "familybench")
+	build := exec.Command("sh", "scripts/build.sh", "familybench", binary)
+	build.Dir, build.Env = root, env
+	if out, e := build.CombinedOutput(); e != nil {
+		t.Fatalf("build: %v\n%s", e, out)
+	}
+	outDir := filepath.Join(t.TempDir(), "result")
+	cmd := exec.Command(binary, "-fixture", "testdata/scoped.manifest.json", "-algorithm", "raptor", "-warmups", "1", "-repetitions", "1", "-batch-size", "1", "-stream-responses", "-out-dir", outDir)
+	cmd.Dir, cmd.Env = root, env
+	output, e := cmd.CombinedOutput()
+	if e != nil {
+		t.Fatalf("CLI: %v\n%s", e, output)
+	}
+	data, e := os.ReadFile(filepath.Join(outDir, "available-responses.jsonl"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if len(lines) != 3 {
+		t.Fatal("warmup or forced-deadline leaked into measured stream", len(lines))
+	}
+	for _, line := range lines {
+		var a availableAnswer
+		if e := json.Unmarshal([]byte(line), &a); e != nil {
+			t.Fatal(e)
+		}
+		if !a.Completed || !a.Attempted || a.Status != "complete" {
+			t.Fatal("bad ordinary answer", a)
+		}
+	}
+	markers := 0
+	for _, line := range strings.Split(string(output), "\n") {
+		if strings.HasPrefix(line, "{\"event\":\"first_available_answer\"") {
+			markers++
+		}
+	}
+	if markers != 1 {
+		t.Fatal("missing or repeated first available answer", markers, string(output))
+	}
+	for _, name := range []string{"pass-00.json", "pass-01.json", "forced-deadline.json"} {
+		var artifact pass
+		data, e := os.ReadFile(filepath.Join(outDir, name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = json.Unmarshal(data, &artifact); e != nil {
+			t.Fatal(e)
+		}
+		for _, r := range artifact.Records {
+			want := name == "pass-01.json"
+			if (r.PublishedResponseNS != nil) != want || (r.SerializationNS != nil) != want {
+				t.Fatal("publication timer classification", name, r.Query.ID)
+			}
+		}
+	}
+	var summary struct {
+		Stream struct {
+			Enabled bool             `json:"enabled"`
+			Records int              `json:"records"`
+			First   *availableMarker `json:"first_available_answer"`
+		} `json:"response_stream"`
+	}
+	data, e = os.ReadFile(filepath.Join(outDir, "summary.json"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = json.Unmarshal(data, &summary); e != nil {
+		t.Fatal(e)
+	}
+	if !summary.Stream.Enabled || summary.Stream.Records != 3 || summary.Stream.First == nil {
+		t.Fatal("missing summary binding", summary)
+	}
+}
