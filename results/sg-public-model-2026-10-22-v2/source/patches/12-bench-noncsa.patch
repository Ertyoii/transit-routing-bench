+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"time"
+
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/presentation"
+	"github.com/ertyoii/transit-routing-go/recommend"
+)
+
+// Streamed answers are actual validated witnesses, not routing-start or
+// readiness markers. Unbuffered writes return before availability is recorded.
+// The sink is the local process filesystem, not a network/client transport.
+type availableAnswer struct {
+	Event      string                      `json:"event"`
+	Query      model.Query                 `json:"query"`
+	Completed  bool                        `json:"completed"`
+	Attempted  bool                        `json:"attempted"`
+	Status     string                      `json:"status"`
+	Error      string                      `json:"error,omitempty"`
+	ValidEmpty bool                        `json:"valid_empty"`
+	Final      []model.Validated           `json:"final"`
+	Display    map[int]presentation.Result `json:"display_options"`
+	Quality    *recommend.Result           `json:"recommendation_quality,omitempty"`
+	ResponseNS int64                       `json:"response_ns"`
+}
+
+type availableMarker struct {
+	Event               string `json:"event"`
+	QueryID             string `json:"query_id"`
+	AvailableUTC        string `json:"available_utc"`
+	ProcessElapsedNS    int64  `json:"process_elapsed_ns"`
+	PublishedResponseNS int64  `json:"published_response_ns"`
+	SerializationNS     int64  `json:"serialization_ns"`
+	Sink                string `json:"sink"`
+}
+
+type responsePublisher struct {
+	answers         io.Writer
+	marker          io.Writer
+	processStarted  time.Time
+	first           *availableMarker
+	records         int
+	serializationNS int64
+}
+
+func writeJSONLine(w io.Writer, v any) error {
+	b, e := json.Marshal(v)
+	if e != nil {
+		return e
+	}
+	b = append(b, '\n')
+	n, e := w.Write(b)
+	if e == nil && n != len(b) {
+		e = io.ErrShortWrite
+	}
+	return e
+}
+
+func (p *responsePublisher) publish(z *record, submitted time.Time) error {
+	begin := time.Now()
+	a := availableAnswer{Event: "available_answer", Query: z.Query, Completed: z.Completed, Attempted: z.Attempted, Status: z.Status, Error: z.Error, ValidEmpty: z.ValidEmpty, Final: z.Final, Display: z.Display, Quality: z.Quality, ResponseNS: z.ResponseNS}
+	if e := writeJSONLine(p.answers, a); e != nil {
+		return fmt.Errorf("response stream: %w", e)
+	}
+	available := time.Now()
+	published, serialization := available.Sub(submitted).Nanoseconds(), available.Sub(begin).Nanoseconds()
+	z.PublishedResponseNS, z.SerializationNS = &published, &serialization
+	p.records++
+	p.serializationNS += serialization
+	if p.first == nil && z.Completed && z.Attempted {
+		m := availableMarker{Event: "first_available_answer", QueryID: z.Query.ID, AvailableUTC: available.UTC().Format(time.RFC3339Nano), ProcessElapsedNS: available.Sub(p.processStarted).Nanoseconds(), PublishedResponseNS: published, SerializationNS: serialization, Sink: "available-responses.jsonl (local unbuffered filesystem write, not network delivery)"}
+		if e := writeJSONLine(p.marker, m); e != nil {
+			return fmt.Errorf("first answer marker: %w", e)
+		}
+		p.first = &m
+	}
+	return nil
+}
+
+func (p *responsePublisher) summary() map[string]any {
+	if p == nil {
+		return map[string]any{"enabled": false}
+	}
+	return map[string]any{"enabled": true, "file": "available-responses.jsonl", "scope": "measured ordinary records only; warmups and forced deadlines excluded; local unbuffered filesystem availability, not network delivery; historical response_ns ends before serialization", "records": p.records, "serialization_ns": p.serializationNS, "first_available_answer": p.first}
+}
