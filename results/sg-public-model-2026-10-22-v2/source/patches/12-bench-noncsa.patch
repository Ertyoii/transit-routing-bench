+package mcraptor_test
+
+import (
+	"context"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/raptor"
+	"reflect"
+	"testing"
+)
+
+// Independent finite-word enumeration checks the unchanged 2D cap vector;
+// it does not reuse either native RAPTOR to generate the expected answer.
+func TestLocalWalkTiesIndependentWords2D(t *testing.T) {
+	for seed := uint64(0); seed < 96; seed++ {
+		d, q := generated(seed)
+		all := fullWords(d, q, 7)
+		want := objectives(all, q.MaxBoardings)
+		x, e := raptor.New(d)
+		if e != nil {
+			t.Fatal(e)
+		}
+		for _, early := range []bool{false, true} {
+			r, _, e := x.SearchLocalWalkTies(context.Background(), q, early)
+			if e != nil || !r.Complete {
+				t.Fatal(seed, early, e, r)
+			}
+			got := objectives(metrics(t, d, q, r.Journeys), q.MaxBoardings)
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("seed=%d early=%v want=%v got=%v", seed, early, want, got)
+			}
+			// Same-vector walking refinement is only local, not a 3D completeness claim.
+			for _, m := range metrics(t, d, q, r.Journeys) {
+				if m.WalkingSeconds < 0 || m.Boardings > q.MaxBoardings {
+					t.Fatal("invalid objectives", m)
+				}
+			}
+		}
+	}
+}
