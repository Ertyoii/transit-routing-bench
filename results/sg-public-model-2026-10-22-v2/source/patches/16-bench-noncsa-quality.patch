+package main
+
+import (
+	"context"
+	"testing"
+)
+
+func TestLocalWalkTiesScopedAdaptersLiteralAnswers(t *testing.T) {
+	b := scopedFixture(t)
+	for _, tc := range []struct{ name, config string }{{"ultra_capped_local_walk_ties", "ultra-control"}, {"ultra_subset_local_walk_ties", "ultra-subset"}} {
+		if !isScoped(tc.name) {
+			t.Fatal("unregistered quality adapter", tc.name)
+		}
+		r, e := prepareScoped(context.Background(), b.Dataset, tc.name, scopedInput(t, tc.config))
+		if e != nil {
+			t.Fatal(e)
+		}
+		cfg, ok := r.config.(map[string]any)
+		if !ok || cfg["native_contract"] != "arrival_boardings_2d_not_3d" || cfg["minimum_walking_representatives_complete"] != false {
+			t.Fatal("lost named contract", r.config)
+		}
+		for i, q := range b.Queries {
+			v := r.single(context.Background(), q)
+			if v.Err != nil || !v.Complete {
+				t.Fatal(tc.name, q.ID, v.Err)
+			}
+			if got := bestArrival(t, b.Dataset, q, v.Journeys); got != []int64{30, 20, -1}[i] {
+				t.Fatal("literal answer changed", tc.name, q.ID, got)
+			}
+		}
+	}
+}
