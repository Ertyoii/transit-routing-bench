+ if cfg.Bounded!=nil{var c *ContinuousChoices;c,err=SelectBounded(ctx,fs,cfg);if c!=nil{pool:=[]Feature{};for _,f:=range fs{if _,excluded:=c.Exclusions[f.Identity];!excluded{pool=append(pool,f)}};mode:="bounded_score_only_representatives";if cfg.Bounded.DistinctPatterns{mode="bounded_full_pattern_aware_representatives"};reduction=offlineReduction(fs,pool,c.Exclusions,mode,c.RetainedCandidates==len(pool));for _,s:=range c.Selections{out=append(out,OfflineSelection{Policy:c.Policy,Limit:s.Limit,Selected:s.Selected,Complete:c.Complete&&s.Complete,Details:s})}};return}
