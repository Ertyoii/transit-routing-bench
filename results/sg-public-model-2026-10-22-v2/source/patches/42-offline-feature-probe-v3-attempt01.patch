+package recommend
+import("context";"errors";"testing";"github.com/ertyoii/transit-routing-go/model")
+func offlineFeature(id,pattern string,d int64,b int,w int64)Feature{return Feature{Identity:id,Pattern:pattern,Duration:d,Metrics:model.Metrics{Arrival:d,Boardings:b,Transfers:max(0,b-1),WalkingSeconds:w}}}
+func TestOfflineReductionPatternAvailability(t *testing.T){fs:=[]Feature{offlineFeature("a","pattern-a",100,1,0),offlineFeature("b","pattern-b",100,1,0),offlineFeature("c","pattern-c",200,2,20)};cfg:=ChoiceConfig{MaxCandidates:100,MaxSubsets:10000,Bounded:&BoundedConfig{MaxTransfer:900,MaxWalk:4,Objective:"absolute",Limits:[]int{3,5},DistinctPatterns:true,MaxCriticalPoints:1000,MaxWork:1000000}};_,r,e:=ReplayFeatureControls(context.Background(),fs,cfg);if e!=nil||r==nil||!r.Complete||r.OriginalPatterns!=3||r.RetainedPatterns!=3||r.RetainedCandidates!=3||r.MultiPatternEqualVectorGroupsBefore!=1||r.MultiPatternEqualVectorGroupsAfter!=1{t.Fatalf("distinct collapse: %+v %v",r,e)};cfg.Bounded=nil;cfg.LeanDelivery=true;cfg.DeliveryPolicy="finite_preferences_v2";cfg.DeliveryLimits=[]int{3,5};cfg.Groups=[]PreferenceGroup{{Name:"one",Preferences:[]Preference{{ID:"zero"}}}};_,r,e=ReplayFeatureControls(context.Background(),fs,cfg);if e!=nil||r==nil||r.RetainedPatterns!=1||r.RetainedCandidates!=1||r.LostPatterns!=2||r.MultiPatternEqualVectorGroupsAfter!=0{t.Fatalf("finite collapse hidden: %+v %v",r,e)};cfg.DeliveryPolicy="pattern_anchors_v1";cfg.Groups=nil;_,r,e=ReplayFeatureControls(context.Background(),fs,cfg);if e!=nil||r.RetainedPatterns!=2||r.RetainedCandidates!=2{t.Fatalf("pattern eligibility wrong: %+v %v",r,e)}}
+func TestOfflineReductionGuards(t *testing.T){fs:=[]Feature{offlineFeature("a","a",100,1,0),offlineFeature("b","b",90,2,0)};cfg:=ChoiceConfig{MaxCandidates:100,MaxSubsets:10000,Bounded:&BoundedConfig{MaxTransfer:900,MaxWalk:4,Objective:"absolute",Limits:[]int{3},MaxCriticalPoints:1000,MaxWork:1}};_,r,e:=ReplayFeatureControls(context.Background(),fs,cfg);if !errors.Is(e,ErrSelectionBudget)||r==nil||r.Complete{t.Fatalf("guard falsely qualified reduction: %+v %v",r,e)};cfg.Bounded=nil;cfg.LeanDelivery=true;cfg.DeliveryPolicy="pattern_anchors_v1";_,_,e=ReplayFeatureControls(context.Background(),[]Feature{fs[0],fs[0]},cfg);if e==nil{t.Fatal("duplicate replay identity accepted")}}
