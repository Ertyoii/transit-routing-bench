+package recommend
+import("context";"fmt";"sort";"strings")
+type OfflineSelection struct {Policy string `json:"policy"`;Limit int `json:"limit"`;Selected []string `json:"selected"`;Complete bool `json:"complete"`;Details any `json:"details"`}
+type OfflineReduction struct {Mode string `json:"mode"`;Complete bool `json:"complete"`;OriginalCandidates int `json:"original_candidates"`;OriginalPatterns int `json:"original_patterns"`;RetainedCandidates int `json:"retained_candidates"`;RetainedPatterns int `json:"retained_patterns"`;LostPatterns int `json:"lost_patterns"`;MultiPatternEqualVectorGroupsBefore int `json:"multi_pattern_equal_vector_groups_before"`;MultiPatternEqualVectorGroupsAfter int `json:"multi_pattern_equal_vector_groups_after"`;Retained []string `json:"retained_ids"`;Excluded map[string]string `json:"excluded"`}
+func offlineReduction(fs,pool []Feature,excluded map[string]string,mode string,complete bool)*OfflineReduction{
+ patterns:=map[string]bool{};retained:=map[string]bool{};before:=map[[3]int64]map[string]bool{};after:=map[[3]int64]map[string]bool{};out:=&OfflineReduction{Mode:mode,Complete:complete,OriginalCandidates:len(fs),RetainedCandidates:len(pool),Retained:[]string{},Excluded:excluded}
+ for _,f:=range fs{patterns[f.Pattern]=true;v:=vector(f);if before[v]==nil{before[v]=map[string]bool{}};before[v][f.Pattern]=true}
+ for _,f:=range pool{retained[f.Pattern]=true;out.Retained=append(out.Retained,f.Identity);v:=vector(f);if after[v]==nil{after[v]=map[string]bool{}};after[v][f.Pattern]=true};sort.Strings(out.Retained);out.OriginalPatterns=len(patterns);out.RetainedPatterns=len(retained);for p:=range patterns{if !retained[p]{out.LostPatterns++}};for _,ps:=range before{if len(ps)>1{out.MultiPatternEqualVectorGroupsBefore++}};for _,ps:=range after{if len(ps)>1{out.MultiPatternEqualVectorGroupsAfter++}};return out
+}
+// Independently reconstructed features only; no new routing/feasibility claim.
+func ReplayFeatureControls(ctx context.Context,fs []Feature,cfg ChoiceConfig)(out []OfflineSelection,reduction *OfflineReduction,err error){
