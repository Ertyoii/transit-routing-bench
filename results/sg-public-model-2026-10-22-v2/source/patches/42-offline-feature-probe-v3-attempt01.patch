+ if cfg.DeliveryPolicy=="pattern_anchors_v1"{for _,k:=range limits{s:=selectFeatures(fs,k,300);if reduction==nil{pool:=[]Feature{};excluded:=map[string]string{};for _,f:=range fs{why:=s.Decisions[f.Identity];if why=="capacity"||strings.HasPrefix(why,"selected_"){pool=append(pool,f)}else{excluded[f.Identity]=why}};reduction=offlineReduction(fs,pool,excluded,"pattern_envelope_300_and_scalar_dominance_before_anchor_capacity",true)};out=append(out,OfflineSelection{Policy:"pattern_anchors_v1",Limit:k,Selected:s.Selected,Complete:true,Details:s})};return}
+ excluded:=map[string]string{};pool:=choiceRepresentatives(fs,excluded);reduction=offlineReduction(fs,pool,excluded,"finite20_score_only_equal_vector_and_monotone_dominance",true);for _,g:=range cfg.Groups{for _,k:=range limits{var ids []int;var states int;ids,states,err=minimax(ctx,pool,g.Preferences,k,cfg.MaxSubsets);if err!=nil{return};s:=describeChoice(pool,g.Preferences,ids,"preference_minimax",k);s.Complete=true;s.PoolOptimal=true;s.EvaluatedSubsets=states;out=append(out,OfflineSelection{Policy:"finite_preferences_v2",Limit:k,Selected:s.Selected,Complete:true,Details:s})}};return
