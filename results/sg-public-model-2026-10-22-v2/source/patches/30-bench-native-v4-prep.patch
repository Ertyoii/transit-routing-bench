@@ -0,0 +1,35 @@
+package main
+
+import (
+	"fmt"
+	"github.com/ertyoii/transit-routing-bench/workloadseed"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/profilequery"
+)
+
+type pointInput struct {
+	Seed          workloadseed.Seed `json:"seed"`
+	Method        string            `json:"method"`
+	DatasetSHA256 string            `json:"dataset_sha256"`
+	Items         []struct {
+		Stratum string      `json:"stratum"`
+		Query   model.Query `json:"query"`
+	} `json:"items"`
+}
+
+// profilesFromPoints preserves each query, including its fixed latest arrival
+// horizon and all hard limits. Only readiness becomes a complete inclusive
+// interval. The original point workload bytes remain the recorded query hash.
+func profilesFromPoints(points pointInput, span int64) (workload, error) {
+	if span < 0 {
+		return workload{}, fmt.Errorf("negative ready span")
+	}
+	out := workload{Seed: points.Seed, Method: fmt.Sprintf("fixed_inclusive_ready_span_%ds_from:%s", span, points.Method), DatasetSHA256: points.DatasetSHA256, Items: []item{}}
+	for _, p := range points.Items {
+		if p.Query.Departure < 0 || p.Query.LatestArrival < p.Query.Departure || span > p.Query.LatestArrival-p.Query.Departure {
+			return workload{}, fmt.Errorf("ready span exceeds fixed horizon: %s", p.Query.ID)
+		}
+		out.Items = append(out.Items, item{Stratum: p.Stratum, Query: profilequery.Query{Base: p.Query, End: p.Query.Departure + span}})
+	}
+	return out, nil
+}
--- /dev/null
+++ b/cmd/profilebench/point_input_test.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"github.com/ertyoii/transit-routing-bench/workloadseed"
+	"github.com/ertyoii/transit-routing-go/model"
+	"reflect"
+	"testing"
+)
+
+func TestPointInputPreservesHardLimitsAndFixedHorizon(t *testing.T) {
+	q := model.Query{ID: "tune-only", Origin: "A", Destination: "B", Departure: 100, LatestArrival: 200, MaxBoardings: 4, MaxWalkSeconds: 600, MaxLegs: 99, TransferBuffer: 7}
+	points := pointInput{Seed: workloadseed.Numeric(9), Method: "registered_tune", DatasetSHA256: "bound"}
+	points.Items = append(points.Items, struct {
+		Stratum string      `json:"stratum"`
+		Query   model.Query `json:"query"`
+	}{"uniform", q})
+	got, err := profilesFromPoints(points, 60)
+	if err != nil || len(got.Items) != 1 || !reflect.DeepEqual(got.Items[0].Query.Base, q) || got.Items[0].Query.End != 160 || got.Items[0].Stratum != "uniform" || got.Seed.Uint64() != 9 || got.DatasetSHA256 != "bound" {
+		t.Fatalf("got %+v err %v", got, err)
+	}
+	for _, span := range []int64{-1, 101} {
+		if _, err := profilesFromPoints(points, span); err == nil {
+			t.Fatal("invalid span accepted", span)
+		}
+	}
+	zero, err := profilesFromPoints(points, 0)
+	if err != nil || zero.Items[0].Query.End != q.Departure {
+		t.Fatal(zero, err)
+	}
+}
