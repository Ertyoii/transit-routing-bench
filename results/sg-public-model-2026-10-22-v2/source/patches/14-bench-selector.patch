+// selectorprobe replays validated objective features only. It does not validate
+// journey feasibility and cannot be used to upgrade a router's completeness.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/ertyoii/transit-routing-go/recommend"
+	"io"
+	"os"
+)
+
+func main() {
+	dec := json.NewDecoder(os.Stdin)
+	enc := json.NewEncoder(os.Stdout)
+	failed := false
+	for {
+		var req struct {
+			Features []recommend.Feature    `json:"features"`
+			Config   recommend.ChoiceConfig `json:"config"`
+		}
+		err := dec.Decode(&req)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+		out, err := recommend.SelectBounded(context.Background(), req.Features, req.Config)
+		if out != nil {
+			enc.Encode(out)
+		} else {
+			enc.Encode(map[string]any{"complete": false, "error": fmt.Sprint(err)})
+		}
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			failed = true
+		}
+	}
+	if failed {
+		os.Exit(1)
+	}
+}
