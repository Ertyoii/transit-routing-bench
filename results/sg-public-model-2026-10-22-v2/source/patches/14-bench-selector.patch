+package oracle_test
+
+import (
+	"context"
+	"errors"
+	"github.com/ertyoii/transit-routing-bench/oracle"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/validate"
+	"math"
+	"testing"
+)
+
+func TestScalarIndependentVsExhaustive(t *testing.T) {
+	b := fixture(t)
+	for _, d := range []struct {
+		name    string
+		weights oracle.ScalarWeights
+	}{{"zero", oracle.ScalarWeights{}}, {"fractional", oracle.ScalarWeights{Transfer: 173.125, ExtraWalk: 1.875}}, {"walking", oracle.ScalarWeights{Transfer: 900, ExtraWalk: 4}}} {
+		t.Run(d.name, func(t *testing.T) {
+			index, err := oracle.NewScalar(b.Dataset)
+			if err != nil {
+				t.Fatal(err)
+			}
+			checker, err := validate.New(b.Dataset)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, q := range b.Queries {
+				all := solve(t, b.Dataset, q)
+				r, err := index.Search(context.Background(), q, d.weights, oracle.ScalarLimits{MaxLabels: 100000, MaxTransitions: 1000000})
+				if err != nil || !r.Complete {
+					t.Fatalf("oracle incomplete: %+v %v", r, err)
+				}
+				if len(all) == 0 {
+					if r.Found {
+						t.Fatal("invented route")
+					}
+					continue
+				}
+				opt := math.Inf(1)
+				for _, v := range all {
+					m := v.Metrics
+					s := float64(m.Arrival-q.Departure) + d.weights.Transfer*float64(m.Transfers) + d.weights.ExtraWalk*float64(m.WalkingSeconds)
+					opt = math.Min(opt, s)
+				}
+				if !r.Found || math.Abs(*r.Cost-opt) > 1e-9 {
+					t.Fatalf("scalar differs exhaustive q%s: got %+v want %f", q.ID, r, opt)
+				}
+				v, err := checker.Check(q, *r.Journey)
+				if err != nil {
+					t.Fatalf("oracle witness invalid: %v", err)
+				}
+				got := float64(v.Metrics.Arrival-q.Departure) + d.weights.Transfer*float64(v.Metrics.Transfers) + d.weights.ExtraWalk*float64(v.Metrics.WalkingSeconds)
+				if got != opt {
+					t.Fatal("reported cost mismatches witness")
+				}
+			}
+		})
+	}
+}
+func TestScalarBudgetAndCancelInconclusive(t *testing.T) {
+	b := fixture(t)
+	x, err := oracle.NewScalar(b.Dataset)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := x.Search(context.Background(), b.Queries[0], oracle.ScalarWeights{}, oracle.ScalarLimits{MaxLabels: 1, MaxTransitions: 10000})
+	var trunc *oracle.TruncatedError
+	if !errors.As(err, &trunc) || r.Complete {
+		t.Fatalf("budget falsely complete %+v %v", r, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	r, err = x.Search(ctx, b.Queries[0], oracle.ScalarWeights{}, oracle.ScalarLimits{MaxLabels: 100, MaxTransitions: 10000})
+	if !errors.Is(err, context.Canceled) || r.Complete {
+		t.Fatal("cancellation lost")
+	}
+}
+
+func TestScalarDestinationAbsorbsBeforeWalkingRoleCap(t *testing.T) {
+	d := model.Dataset{SchemaVersion: "0.2", ID: "absorbing-destination", TimeZone: "UTC", ServiceDate: "2026-10-20", Stops: []model.Stop{{ID: "A", Accessible: model.Yes}, {ID: "D", Accessible: model.Yes}, {ID: "X", Accessible: model.Yes}}, Trips: []model.Trip{{ID: "dx", Accessible: model.Yes}, {ID: "xd", Accessible: model.Yes}}, Connections: []model.Connection{{ID: "dx", TripID: "dx", From: "D", To: "X", Departure: 3, Arrival: 4, Pickup: true, Dropoff: true}, {ID: "xd", TripID: "xd", From: "X", To: "D", Departure: 5, Arrival: 6, Pickup: true, Dropoff: true}}, Footpaths: []model.Footpath{{ID: "ad", From: "A", To: "D", Duration: 2, Accessible: model.Yes}}}
+	q := model.Query{ID: "role-cap", Origin: "A", Destination: "D", LatestArrival: 100, MaxWalkSeconds: 3, MaxBoardings: 2, MaxLegs: 3, Walking: &model.WalkingLimits{Access: 3, Transfer: 3, Egress: 3, Direct: 1}}
+	x, err := oracle.NewScalar(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := x.Search(context.Background(), q, oracle.ScalarWeights{}, oracle.ScalarLimits{MaxLabels: 1000, MaxTransitions: 1000})
+	if err != nil || !r.Complete || r.Found {
+		t.Fatalf("left rejected destination and reset walking role: %+v %v", r, err)
+	}
+	all, err := oracle.Enumerate(context.Background(), d, q, oracle.Limits{MaxStates: 1000, MaxJourneys: 1000})
