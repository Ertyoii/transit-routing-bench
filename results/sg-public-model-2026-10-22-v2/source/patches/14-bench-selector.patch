+package oracle
+
+// Scalar is an independent resource-label-setting oracle, not a contributor
+// union. It uses raw input events and explicit resource/context labels. No
+// production routing index, search, dominance or transfer resolver is imported.
+import (
+	"container/heap"
+	"context"
+	"fmt"
+	"math"
+
+	"github.com/ertyoii/transit-routing-go/model"
+)
+
+type ScalarWeights struct {
+	Transfer  float64 `json:"transfer_seconds"`
+	ExtraWalk float64 `json:"extra_walk_weight"`
+}
+type ScalarLimits struct {
+	MaxLabels      int `json:"max_labels"`
+	MaxTransitions int `json:"max_transitions"`
+}
+type ScalarResult struct {
+	Complete    bool           `json:"complete"`
+	Found       bool           `json:"found"`
+	Cost        *float64       `json:"score_seconds"`
+	Journey     *model.Journey `json:"journey,omitempty"`
+	Labels      int            `json:"labels"`
+	Transitions int            `json:"transitions"`
+	Settled     int            `json:"settled"`
+	Error       string         `json:"error,omitempty"`
+	Contract    string         `json:"contract"`
+}
+type ScalarIndex struct {
+	d        model.Dataset
+	rides    map[string][]int
+	walks    map[string][]int
+	stops    map[string]bool
+	trips    map[string]bool
+	tripData map[string]model.Trip
+	parent   map[string]string
+	stations map[string]bool
+}
+
+// NewScalar requires the input tables remain immutable throughout this oracle
+// run; the standalone CLI owns its parsed input and never mutates it.
+func NewScalar(d model.Dataset) (*ScalarIndex, error) {
+	if err := d.Validate(); err != nil {
+		return nil, err
+	}
+	x := &ScalarIndex{d: d, rides: map[string][]int{}, walks: map[string][]int{}, stops: map[string]bool{}, trips: map[string]bool{}, tripData: map[string]model.Trip{}, parent: map[string]string{}, stations: map[string]bool{}}
+	for i, c := range d.Connections {
+		x.rides[c.From] = append(x.rides[c.From], i)
+	}
+	for i, w := range d.Footpaths {
+		x.walks[w.From] = append(x.walks[w.From], i)
+	}
+	for _, s := range d.Stops {
+		x.stops[s.ID] = s.Accessible == model.Yes
+		x.parent[s.ID] = s.ParentStation
+		x.stations[s.ID] = s.LocationType == 1
+	}
+	for _, t := range d.Trips {
+		x.trips[t.ID] = t.Accessible == model.Yes
+		x.tripData[t.ID] = t
+	}
+	return x, nil
+}
+
+type scalarKey struct {
+	stop             string
+	on, last, boards int
+}
+type scalarLabel struct {
+	key               scalarKey
+	time, walk, block int64
+	legs              int
+	cost              float64
+	prev              *scalarLabel
+	leg               model.Leg
+	active            bool
+	serial            int
+}
+type scalarHeap []*scalarLabel
+
+func (h scalarHeap) Len() int { return len(h) }
+func (h scalarHeap) Less(i, j int) bool {
+	if h[i].cost != h[j].cost {
+		return h[i].cost < h[j].cost
+	}
+	return h[i].serial < h[j].serial
+}
+func (h scalarHeap) Swap(i, j int) { h[i], h[j] = h[j], h[i] }
+func (h *scalarHeap) Push(v any)   { *h = append(*h, v.(*scalarLabel)) }
+func (h *scalarHeap) Pop() any     { old := *h; v := old[len(old)-1]; *h = old[:len(old)-1]; return v }
+func dominatesScalar(a, b *scalarLabel) bool {
+	return a.time <= b.time && a.walk <= b.walk && a.block <= b.block && a.legs <= b.legs
+}
+func (x *ScalarIndex) Search(ctx context.Context, q model.Query, w ScalarWeights, lim ScalarLimits) (out ScalarResult, err error) {
+	out.Contract = "exact minimum elapsed + transfer penalty*max(0,boardings-1) + extra-walk-weight*walking over finite input/query contract if complete; independent resource-label-setting, no contributor-pool truth"
+	defer func() {
+		if err != nil {
+			out.Complete = false
+			out.Error = err.Error()
+		}
+	}()
+	if err = q.Validate(x.d); err != nil {
+		return
+	}
+	if math.IsNaN(w.Transfer) || math.IsInf(w.Transfer, 0) || math.IsNaN(w.ExtraWalk) || math.IsInf(w.ExtraWalk, 0) || w.Transfer < 0 || w.Transfer > float64(model.MaxServiceSecond) || w.ExtraWalk < 0 || w.ExtraWalk > 1000 || lim.MaxLabels < 1 || lim.MaxTransitions < 1 {
+		return out, fmt.Errorf("invalid scalar oracle weights/budgets")
+	}
+	if err = ctx.Err(); err != nil {
+		return
+	}
+	if q.AccessibleOnly && (!x.stops[q.Origin] || !x.stops[q.Destination]) {
+		out.Complete = true
+		return
+	}
+	pq := &scalarHeap{}
+	heap.Init(pq)
+	front := map[scalarKey][]*scalarLabel{}
+	add := func(s *scalarLabel) error {
+		if s.time > q.LatestArrival || s.walk > q.MaxWalkSeconds || s.legs > q.MaxLegs || s.key.boards > q.MaxBoardings {
+			return nil
+		}
+		f := front[s.key]
+		for _, o := range f {
+			if o.active && dominatesScalar(o, s) {
+				return nil
+			}
+		}
+		if out.Labels >= lim.MaxLabels {
+			return &TruncatedError{Limit: "scalar labels"}
+		}
+		retained := f[:0]
+		for _, o := range f {
+			if o.active && dominatesScalar(s, o) {
+				o.active = false
+			}
+			if o.active {
+				retained = append(retained, o)
+			}
+		}
+		s.cost = float64(s.time-q.Departure) + w.Transfer*float64(max(0, s.key.boards-1)) + w.ExtraWalk*float64(s.walk)
+		s.serial = out.Labels
+		s.active = true
+		front[s.key] = append(retained, s)
+		out.Labels++
+		heap.Push(pq, s)
+		return nil
+	}
+	if err = add(&scalarLabel{key: scalarKey{q.Origin, -1, -1, 0}, time: q.Departure}); err != nil {
+		return
+	}
+	transition := func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if out.Transitions >= lim.MaxTransitions {
+			return &TruncatedError{Limit: "scalar transitions"}
+		}
+		out.Transitions++
+		return nil
+	}
+	for pq.Len() > 0 {
+		if err = ctx.Err(); err != nil {
+			return
+		}
+		s := heap.Pop(pq).(*scalarLabel)
+		if !s.active {
+			continue
+		}
+		out.Settled++
+		exitOK := s.key.on < 0 || (x.d.Connections[s.key.on].Dropoff && (!q.AccessibleOnly || x.stops[s.key.stop]))
+		if s.key.stop == q.Destination && exitOK {
+			capOK := true
+			if q.Walking != nil {
+				cap := q.Walking.Egress
+				if s.key.boards == 0 {
+					cap = q.Walking.Direct
+				}
+				capOK = s.block <= cap
+			}
+			if capOK {
+				legs := []model.Leg{}
+				for p := s; p.prev != nil; p = p.prev {
+					legs = append(legs, p.leg)
+				}
+				for i, j := 0, len(legs)-1; i < j; i, j = i+1, j-1 {
+					legs[i], legs[j] = legs[j], legs[i]
+				}
+				j := model.Journey{Legs: legs}
+				v := s.cost
+				out.Journey = &j
+				out.Cost = &v
+				out.Found = true
+				out.Complete = true
+				return
+			}
+			// The native contract absorbs any eligible destination, even when
+			// its final role-specific walking cap rejects the journey. Do not
+			// leave/reboard and reset the block to fabricate a later witness.
+			continue
+		}
+		if s.legs >= q.MaxLegs {
+			continue
+		}
+		for _, i := range x.rides[s.key.stop] {
+			if err = transition(); err != nil {
+				return
+			}
+			c := x.d.Connections[i]
+			if c.Departure < s.time || c.Arrival > q.LatestArrival {
+				continue
+			}
+			continuing := false
+			if s.key.on >= 0 {
+				prior := x.d.Connections[s.key.on]
+				continuing = c.TripID == prior.TripID && c.Sequence == prior.Sequence+1
+			}
+			boards := s.key.boards
+			if !continuing {
+				if !exitOK || !c.Pickup || q.AccessibleOnly && (!x.stops[c.From] || !x.trips[c.TripID]) {
+					continue
+				}
+				if q.Walking != nil {
+					cap := q.Walking.Transfer
+					if boards == 0 {
+						cap = q.Walking.Access
+					}
+					if s.block > cap {
+						continue
+					}
+				}
+				if boards > 0 {
+					var allowed bool
+					var minimum int64
+					allowed, minimum, err = x.rule(x.d.Connections[s.key.last], c, q.TransferBuffer)
+					if err != nil {
+						return
+					}
+					if !allowed || c.Departure < x.d.Connections[s.key.last].Arrival+minimum {
+						continue
+					}
+				}
+				boards++
+			}
+			if boards > q.MaxBoardings {
+				continue
+			}
+			err = add(&scalarLabel{key: scalarKey{c.To, i, i, boards}, time: c.Arrival, walk: s.walk, legs: s.legs + 1, prev: s, leg: model.Leg{Kind: "ride", Ref: c.ID, Departure: c.Departure, Arrival: c.Arrival}})
+			if err != nil {
+				return
+			}
+		}
+		if exitOK {
+			for _, i := range x.walks[s.key.stop] {
+				if err = transition(); err != nil {
+					return
+				}
+				f := x.d.Footpaths[i]
+				if q.AccessibleOnly && (!x.stops[f.From] || !x.stops[f.To] || f.Accessible != model.Yes) {
+					continue
+				}
+				block := s.block + f.Duration
+				if q.Walking != nil {
+					cap := max(q.Walking.Transfer, q.Walking.Egress)
+					if s.key.boards == 0 {
+						cap = max(q.Walking.Access, q.Walking.Direct)
+					}
+					if block > cap {
+						continue
+					}
+				}
+				err = add(&scalarLabel{key: scalarKey{f.To, -1, s.key.last, s.key.boards}, time: s.time + f.Duration, walk: s.walk + f.Duration, block: block, legs: s.legs + 1, prev: s, leg: model.Leg{Kind: "walk", Ref: f.ID, Departure: s.time, Arrival: s.time + f.Duration}})
+				if err != nil {
+					return
+				}
+			}
+		}
+	}
+	out.Complete = true
+	return
+}
+
+// rule independently scans all input rules but uses immutable input lookup maps.
+// It shares no production transfer resolver or per-query routing state.
+func (x *ScalarIndex) rule(arriving, departing model.Connection, fallback int64) (bool, int64, error) {
+	a, b := x.tripData[arriving.TripID], x.tripData[departing.TripID]
+	aid, bid := a.SourceID, b.SourceID
+	if aid == "" {
+		aid = a.ID
+	}
+	if bid == "" {
+		bid = b.ID
+	}
+	match := func(rule, actual string) bool { return rule == actual || x.parent[actual] == rule && x.stations[rule] }
+	top := 0
+	matches := 0
+	var selected *model.TransferRule
+	for i := range x.d.Transfers {
+		r := &x.d.Transfers[i]
+		if !match(r.FromStop, arriving.To) || !match(r.ToStop, departing.From) {
+			continue
+		}
+		if r.FromTrip != "" && r.FromTrip != aid || r.ToTrip != "" && r.ToTrip != bid || r.FromRoute != "" && r.FromRoute != a.RouteID || r.ToRoute != "" && r.ToRoute != b.RouteID {
+			continue
+		}
+		level := 1
+		if r.FromRoute != "" || r.ToRoute != "" {
+			level = 2
+		}
+		if r.FromRoute != "" && r.ToRoute != "" {
+			level = 3
+		}
+		if r.FromTrip != "" || r.ToTrip != "" {
+			level = 4
+		}
+		if r.FromTrip != "" && r.ToRoute != "" || r.ToTrip != "" && r.FromRoute != "" {
+			level = 5
+		}
+		if r.FromTrip != "" && r.ToTrip != "" {
+			level = 6
+		}
+		if level > top {
+			top = level
+			matches = 1
+			selected = r
+		} else if level == top {
+			matches++
+		}
+	}
+	if matches > 1 {
+		return false, 0, fmt.Errorf("scalar oracle: ambiguous maximal transfer rules")
+	}
+	if selected == nil {
+		return true, fallback, nil
+	}
+	minimum := int64(0)
+	if selected.Type == 2 {
+		minimum = selected.MinSeconds
+	}
+	return selected.Type != 3, minimum, nil
+}
