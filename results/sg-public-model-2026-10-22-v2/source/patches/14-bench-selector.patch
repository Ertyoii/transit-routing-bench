+package regression_test
+
+import (
+	"context"
+	"github.com/ertyoii/transit-routing-bench/fixtures"
+	"github.com/ertyoii/transit-routing-bench/oracle"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/recommend"
+	"github.com/ertyoii/transit-routing-go/validate"
+	"reflect"
+	"testing"
+)
+
+func TestLeanSharedCheckerFeatureAndOutputParity(t *testing.T) {
+	b, _, err := fixtures.Load("../testdata/tiny.manifest.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	checker, err := validate.New(b.Dataset)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lean, err := recommend.NewBoundedFromChecker(checker)
+	if err != nil {
+		t.Fatal(err)
+	}
+	full, err := recommend.New(b.Dataset)
+	if err != nil {
+		t.Fatal(err)
+	}
+	q := b.Queries[0]
+	r, err := oracle.Enumerate(context.Background(), b.Dataset, q, oracle.Limits{MaxStates: 100000, MaxJourneys: 10000})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := recommend.ChoiceConfig{MaxCandidates: 100, MaxSubsets: 10000, Bounded: &recommend.BoundedConfig{MaxTransfer: 900, MaxWalk: 4, Objective: "absolute", Limits: []int{3}, MaxCriticalPoints: 10000, MaxWork: 10000000, Exact: true}}
+	a, err := full.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	z, err := lean.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil || !reflect.DeepEqual(a, z) {
+		t.Fatalf("full/lean mismatch %v", err)
+	}
+	if _, err = lean.Evaluate(q, r.Journeys); err == nil {
+		t.Fatal("lean silently fabricated recovery")
+	}
+	// The checker owns value copies: mutations to original input cannot affect lean.
+	b.Dataset.Connections[0].Arrival++
+	after, err := lean.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil || !reflect.DeepEqual(z, after) {
+		t.Fatalf("caller mutation changed shared snapshot: %v", err)
+	}
+	if _, err = recommend.NewBoundedFromChecker(nil); err == nil {
+		t.Fatal("nil checker accepted")
+	}
+	// Same finite20 output semantics, with only requested top3 calculated.
+	cfg.Bounded = nil
+	cfg.Groups = []recommend.PreferenceGroup{{Name: "grid", Preferences: []recommend.Preference{{ID: "a"}, {ID: "b", TransferSeconds: 300, ExtraWalkWeight: 2}}}}
+	legacy, err := full.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.LeanDelivery = true
+	cfg.DeliveryLimits = []int{3}
+	small, err := lean.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(small.Choices.Groups[0].Selections) != 1 || !reflect.DeepEqual(legacy.Choices.Groups[0].Selections[1], small.Choices.Groups[0].Selections[0]) {
+		t.Fatal("finite lean changes minimax output")
+	}
+	cfg.Groups = nil
+	cfg.DeliveryPolicy = "pattern_anchors_v1"
+	pattern, err := lean.EvaluateChoices(context.Background(), q, r.Journeys, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old, err := full.Evaluate(q, r.Journeys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var expected recommend.Selection
+	for _, s := range old.Selections {
+		if s.Limit == 3 && s.Envelope == 300 {
+			expected = s
+		}
+	}
+	if len(pattern.Selections) != 1 || !reflect.DeepEqual(expected, pattern.Selections[0]) {
+		t.Fatal("pattern lean changes old output")
+	}
+	_ = model.Journey{}
+}
