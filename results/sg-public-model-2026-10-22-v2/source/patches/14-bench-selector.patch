+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"github.com/ertyoii/transit-routing-bench/experiment"
+	"github.com/ertyoii/transit-routing-bench/oracle"
+	"github.com/ertyoii/transit-routing-go/model"
+	"github.com/ertyoii/transit-routing-go/validate"
+	"os"
+	"time"
+)
+
+func read(path string, v any) (string, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return "", err
+	}
+	s := sha256.Sum256(b)
+	return hex.EncodeToString(s[:]), json.Unmarshal(b, v)
+}
+func run() error {
+	dp := flag.String("dataset", "", "normalized dataset")
+	qp := flag.String("queries", "", "frozen workload JSON")
+	wp := flag.String("weights", "", "frozen fractional weights JSON array")
+	op := flag.String("out", "", "new JSONL output path")
+	ml := flag.Int("max-labels", 2000000, "label guard")
+	mt := flag.Int("max-transitions", 100000000, "transition guard")
+	timeout := flag.Duration("timeout", 60*time.Second, "per scalar optimum deadline; exceeded stays inconclusive")
+	flag.Parse()
+	if *dp == "" || *qp == "" || *wp == "" || *op == "" {
+		return fmt.Errorf("dataset, queries, weights and out required")
+	}
+	var d model.Dataset
+	var work struct {
+		DatasetSHA string `json:"dataset_sha256"`
+		Items      []struct {
+			Stratum string      `json:"stratum"`
+			Query   model.Query `json:"query"`
+		} `json:"items"`
+	}
+	var weights []oracle.ScalarWeights
+	dh, err := read(*dp, &d)
+	if err != nil {
+		return err
+	}
+	qh, err := read(*qp, &work)
+	if err != nil {
+		return err
+	}
+	wh, err := read(*wp, &weights)
+	if err != nil {
+		return err
+	}
+	if work.DatasetSHA != dh {
+		return fmt.Errorf("workload dataset hash mismatch")
+	}
+	index, err := oracle.NewScalar(d)
+	if err != nil {
+		return err
+	}
+	checker, err := validate.New(d)
+	if err != nil {
+		return err
+	}
+	f, err := os.OpenFile(*op, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	enc := json.NewEncoder(f)
+	if err = enc.Encode(map[string]any{"kind": "metadata", "build_source_sha256": experiment.BuildSourceSHA256, "dataset_sha256": dh, "workload_sha256": qh, "weights_sha256": wh, "max_labels": *ml, "max_transitions": *mt, "timeout": timeout.String(), "provenance": "independent resource-label-setting scalar oracle; no router/contributor union"}); err != nil {
+		return err
+	}
+	for _, item := range work.Items {
+		for wi, w := range weights {
+			ctx, cancel := context.WithTimeout(context.Background(), *timeout)
+			begin := time.Now()
+			r, e := index.Search(ctx, item.Query, w, oracle.ScalarLimits{MaxLabels: *ml, MaxTransitions: *mt})
+			elapsed := time.Since(begin).Nanoseconds()
+			cancel()
+			record := map[string]any{"kind": "scalar_result", "oracle_elapsed_ns": elapsed, "query": item.Query, "stratum": item.Stratum, "weight_index": wi, "weight": w, "result": r, "error": ""}
+			if e != nil {
+				record["error"] = e.Error()
+			}
+			if r.Complete && r.Found {
+				v, e := checker.Check(item.Query, *r.Journey)
+				if e != nil {
+					return fmt.Errorf("independent oracle witness invalid: %w", e)
+				}
+				record["validated"] = v
+				cost := float64(v.Metrics.Arrival-item.Query.Departure) + w.Transfer*float64(v.Metrics.Transfers) + w.ExtraWalk*float64(v.Metrics.WalkingSeconds)
+				if r.Cost == nil || cost != *r.Cost {
+					return fmt.Errorf("oracle witness score mismatch")
+				}
+			}
+			if err = enc.Encode(record); err != nil {
+				return err
+			}
+			fmt.Fprintf(os.Stderr, "%s weight%d complete=%v found=%v labels=%d transitions=%d\n", item.Query.ID, wi, r.Complete, r.Found, r.Labels, r.Transitions)
+		}
+	}
+	return nil
+}
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
